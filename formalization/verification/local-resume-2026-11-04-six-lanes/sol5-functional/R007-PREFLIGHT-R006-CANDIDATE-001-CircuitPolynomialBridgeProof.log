case cons
n : ℕ
x : Fin n → ZPolynomial
m : SignedPair.Monomial n
ms : List (SignedPair.Monomial n)
ih :
  expressionPolynomial x (SignedPair.fromMonomials ms) =
    (List.map
        (fun m =>
          C m.coefficient * X ^ m.power *
            match m.unknown with
            | none => 1
            | some i => x i)
        ms).sum
⊢ (C m.coefficient * X ^ m.power *
        match m.unknown with
        | none => 1
        | some i => x i) +
      expressionPolynomial x
        (List.foldr (fun m a => (SignedPair.monomialExpression m).add a) SignedPair.zeroExpression ms) =
    (C m.coefficient * X ^ m.power *
        match m.unknown with
        | none => 1
        | some i => x i) +
      (List.map
          (fun m =>
            C m.coefficient * X ^ m.power *
              match m.unknown with
              | none => 1
              | some i => x i)
          ms).sum
