+  (identityOutputPrimitive b).comp identityInputPrimitive
+
+private theorem optionLiftPrimitive {A T : Type} [Primcodable A] [Primcodable T]
+    {f : A → T} (h : Primrec f) : Primrec (fun a => some (f a)) :=
+  Primrec.option_some.comp h
+
