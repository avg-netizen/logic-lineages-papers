+private theorem maxReadAndCost {A : Type} [Primcodable A]
+    {reads signed modular testTag : A → Nat}
+    (hRead : Primrec reads) (hSigned : Primrec signed) (hModular : Primrec modular)
+    (hTag : Primrec testTag) :
