  "changed_existing_statement_bodies": [
    {
      "id": "05-wilken-weiermann-foundations:thm:forward-translation",
      "previous": {
        "file": "05-wilken-weiermann-foundations/foundations.tex",
        "line": 378,
        "statement_latex": "[Actual-source forward translation]\\label{thm:forward-translation}\nFor a literal original source with only ground free names, all positive\ncanonical coordinates are closed and effectively evaluable.  Coordinate\nzero is effectively a finite expression in positive-natural inputs, constants,\naddition and fixed functions $h_\\lambda(n)=\\psi(\\lambda+n)$, where each\ndirect index is $\\lambda=\\omega\\otimes c>0$ for a closed $c$.\nThe translation preserves every shared input valuation, including arbitrary\ninternal types, binders and recursors.",
        "status": "pending"
      },
      "current": {
        "file": "05-wilken-weiermann-foundations/foundations.tex",
        "line": 412,
        "statement_latex": "[Actual-source forward translation]\\label{thm:forward-translation}\nFix an admissible expansion policy. For a literal original source with only ground free names, all positive\ncanonical coordinates are closed and effectively evaluable.  Coordinate\nzero is effectively a finite expression in positive-natural inputs, constants,\naddition and fixed functions $h_\\lambda(n)=\\psi(\\lambda+n)$, where each\ndirect index is $\\lambda=\\omega\\otimes c>0$ for a closed $c$.\nThe translation preserves every shared input valuation, including arbitrary\ninternal types, binders and recursors. It is effective uniformly in a\nsupplied computable policy; it does not identify assignments made under\ndifferent policies.",
        "status": "pending"
      }
    },
    {
      "id": "05-wilken-weiermann-foundations:cor:source-classes",
      "previous": {
        "file": "05-wilken-weiermann-foundations/foundations.tex",
        "line": 427,
        "statement_latex": "[Two natural positive classes]\\label{cor:source-classes}\nIn a recursor-free source every positive coordinate is finite.  If every\ninternal type and subtype has level at most two, every direct scalar index\nis a polynomial limit below $\\omega^\\omega$.",
        "status": "pending"
      },
      "current": {
        "file": "05-wilken-weiermann-foundations/foundations.tex",
        "line": 463,
        "statement_latex": "[Two natural positive classes]\\label{cor:source-classes}\nFor every fixed admissible policy, in a recursor-free source every positive coordinate is finite.  If every\ninternal type and subtype has level at most two, every direct scalar index\nis a polynomial limit below $\\omega^\\omega$.",
