attribute [local irreducible] programGraph
variable {B : Positive (Fin 1)} {α : Type} {Γ : List (Formula α)}

theorem exact_OpenRemovedScratchNonzero (code : OTerm α)
    (held : Nonempty (Derivation B Γ (unary presentScratch (suc z) code))) :
    Nonempty (Derivation B Γ ((eqn code z).not)) := by
  let E := eqn code z
  let Δ := E :: Γ
  obtain ⟨d⟩ := held
  have eq : Derivation B Δ E := Derivation.hypothesis List.mem_cons_self
  have impossible := headTransport presentScratch (suc z) code z
    (Fin.elim0 : Fin 0 → OTerm α) ⟨eq⟩ ⟨addHyp d E⟩
  have zero : Nonempty (Derivation B Δ (unary presentScratch z z)) := by
    exact zeroBranchIntro (.projection 0) (constantZero 1) (constantOne 1) z ![z]
      (projectionValue 0 ![z]) (constantZeroValue ![z])
  obtain ⟨bad⟩ := valueUnique presentScratch (suc z) z ![z] impossible zero
  exact ⟨Derivation.implicationIntroduction (sucNeZeroApply bad)⟩

/-- The guard recovers a genuine selected constructor of its own scratch
input. The original head and tail reports are chosen from that code. -/
theorem exact_OpenRemovedScratchCons (code : OTerm α) (goal : Formula α)
    (held : Nonempty (Derivation B Γ (unary presentScratch (suc z) code)))
    (next : ∀ (γ : Type) (j : α → γ) (Θ : List (Formula γ)) (head tail : OTerm γ),
      (∀ p ∈ Γ, p.relabel j ∈ Θ) →
      Nonempty (Derivation B Θ (consGraph (code.relabel j) head tail)) →
      Nonempty (Derivation B Θ (goal.relabel j))) :
    Nonempty (Derivation B Γ goal) := by
  have positive := exact_OpenRemovedScratchNonzero code held
  apply programCases headCode ![code] goal
  intro β j Δ h hj head
  rw [inputsRename] at head
  have pos := renameInto positive j Δ hj
  rw [nonzeroRename] at pos
  apply programCases tailCode ![code.relabel j] (goal.relabel j)
  intro γ k Θ t hk tail
  rw [inputsRename] at tail
  have pos' := renameInto pos k Θ hk
  rw [nonzeroRename] at pos'
  have head' := renameInto head k Θ hk
  rw [unaryRename] at head'
  have cell := reconstructNonzero ((code.relabel j).relabel k) (h.relabel k) t pos' head' tail
  rw [formulaRelabelComposition j k goal]
  exact next γ (k ∘ j) Θ (h.relabel k) t (keepThrough j k hj hk)
    (by simpa only [Term.relabel_relabel] using cell)

#print axioms exact_OpenRemovedScratchNonzero
#print axioms exact_OpenRemovedScratchCons
