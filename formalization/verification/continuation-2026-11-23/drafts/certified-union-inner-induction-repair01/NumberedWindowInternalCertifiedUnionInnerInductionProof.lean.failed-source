theorem exact_ActualInnerLowerState {α : Type} (data : Data) (c : Nat) (count : Program 2)
    (Γ : List (Formula α)) (a b y : OTerm α) :
    Pr data c Γ (innerLower data c count a b) →
    Pr data c Γ (edge data true c b y) →
    Pr data c Γ (innerState count a y) := by
  rintro ⟨lower⟩ ⟨step⟩
  have h := Derivation.universalElimination (emb y) lower
  rw [innerLowerAt] at h
  exact ⟨Derivation.implicationElimination h step⟩

/-- The current right component's J is derived from its actual carrier and
the first projection of each strictly lower inner state. This is not J
assumed at the current induction node. -/
theorem exact_RestoreActualInnerMembership {α : Type} (data : Data) (c : Nat)
    (count : Program 2) (Γ : List (Formula α)) (a b : OTerm α) :
    Pr data c Γ (carrier data true c b) →
    Pr data c Γ (innerLower data c count a b) →
    Pr data c Γ (membership true b) := by
  intro typed lower
  apply actualOriginalAccessibilityIntroduction data true c α Γ b typed
  let y : OTerm (α ⊕ Fin 1) := .var (.inr 0)
  let P := edge data true c (b.relabel Sum.inl) y
  let Δ := P :: Γ.map weaken
  have lowered : Pr data c Δ
      (innerLower data c count (a.relabel Sum.inl) (b.relabel Sum.inl)) := by
    have h := renameInto lower Sum.inl Δ
      (fun f hf => List.mem_cons_of_mem _ (List.mem_map.mpr ⟨f,hf,rfl⟩))
    rw [innerLowerRename] at h
    exact h
  have smaller : Pr data c Δ (edge data true c (b.relabel Sum.inl) y) :=
    ⟨Derivation.hypothesis List.mem_cons_self⟩
  obtain ⟨h⟩ := exact_ActualInnerLowerState data c count Δ _ _ y lowered smaller
  exact ⟨Derivation.universalIntroduction
    (Derivation.implicationIntroduction (Derivation.conjunctionLeft h))⟩

/-- An inner progression obligation, with the left term still open.
The consequence is a real derivation with current right J, the actual carrier
and all strict lower right states as its hypotheses. -/
def ActualCertifiedUnionInnerInduction : Prop :=
  ∀ (data : Data) (c : Nat) (count : Program 2) (α : Type)
    (Γ : List (Formula α)) (a t : OTerm α),
    let x : OTerm (α ⊕ Fin 1) := .var (.inr 0)
    let a₀ := a.relabel Sum.inl
    Pr data c (membership true x :: carrier data true c x ::
      innerLower data c count a₀ x :: Γ.map weaken) (consequence count a₀ x) →
    Pr data c Γ ((membership true t).imp (innerState count a t))

theorem exact_ActualCertifiedUnionInnerInduction : ActualCertifiedUnionInnerInduction := by
  intro data c count α Γ a t
  dsimp only
  intro consequenceAt
  let x : OTerm (α ⊕ Fin 1) := .var (.inr 0)
  let a₀ := a.relabel Sum.inl
  let typed := carrier data true c x
  let lower := innerLower data c count a₀ x
  let Δ := typed :: lower :: Γ.map weaken
  have typedNow : Pr data c Δ typed := ⟨Derivation.hypothesis List.mem_cons_self⟩
  have lowerNow : Pr data c Δ lower :=
    ⟨Derivation.hypothesis (List.mem_cons_of_mem _ List.mem_cons_self)⟩
  obtain ⟨rightJ⟩ := exact_RestoreActualInnerMembership data c count Δ a₀ x typedNow lowerNow
  obtain ⟨conseq⟩ := consequenceAt
  have step : Pr data c Δ (innerMotive count a) :=
    ⟨Derivation.conjunctionIntroduction rightJ
      (Derivation.implicationElimination (Derivation.implicationIntroduction conseq) rightJ)⟩
  have progress : Pr data c
      (typed :: oddLower data c x (innerMotive count a) :: Γ.map weaken)
      (innerMotive count a) := by
    rw [literalOddLower]
    exact step
  have done := exact_ActualOriginalOddProgressiveInduction data c α Γ (innerMotive count a) t progress
  rw [innerMotiveAt] at done
  exact done

