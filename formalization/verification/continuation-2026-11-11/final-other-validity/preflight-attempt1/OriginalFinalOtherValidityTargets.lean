module
public import LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalFinalOtherValidityDefinitions
@[expose] public section
namespace LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalFinalOtherValidityTargets
open UniformCertificateCompletion OriginalFinalOtherValidity

/-- Independent internal all-output source exposure, at the original final
Data for arbitrary original inputs and the literal existing OTHER-tag test. -/
def ActualOriginalFinalOtherSourceValidity : Prop :=
  ∀ p : GlobalSourcePackage.Inputs, SourceOtherLaw p

/-- Independent internal all-output target exposure at the SAME final Data,
with precisely the bottom-normalized original target leaf and no source test. -/
def ActualOriginalFinalOtherTargetValidity : Prop :=
  ∀ p : GlobalSourcePackage.Inputs, TargetOtherLaw p

end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalFinalOtherValidityTargets
