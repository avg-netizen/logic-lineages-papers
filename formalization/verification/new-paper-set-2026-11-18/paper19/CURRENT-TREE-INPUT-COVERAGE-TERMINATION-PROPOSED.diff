+/-- Context-independent count of actual original term occurrences. It is
+used solely as the termination measure, never by the compiled DAG builder. -/
+def treeNodes {Ξ : List Ty} {α : Ty} : OriginalTerm Ξ α → Nat
+  | .app f a => treeNodes f + treeNodes a + 1
+  | .lam b => treeNodes b + 1
+  | .var _ | .zeroC | .succC | .caseC _ | .recC _ => 1
+  | .ranked s _ => nomatch s
 
