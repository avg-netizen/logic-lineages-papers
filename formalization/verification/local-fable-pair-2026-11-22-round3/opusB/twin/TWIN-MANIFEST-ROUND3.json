   "body_edits": [
    {
     "diff": "--- LogicLineages/PersistentMarking/NumberedWindowInternalSparseDecodeEvaluationProof.lean\n+++ twin body\n@@ -49,0 +50 @@\n+  symm\n",
     "new": "  let s := x+y\n  symm\n  apply Nat.eq_sqrt.mpr\n",
     "old": "  let s := x+y\n  apply Nat.eq_sqrt.mpr\n",
     "reason": "drafted proof never compiled: pinned Nat.eq_sqrt states `a = sqrt n`; flip the goal with `symm` (one line)"
    },
    {
     "diff": "--- LogicLineages/PersistentMarking/NumberedWindowInternalSparseDecodeEvaluationProof.lean\n+++ twin body\n@@ -64,0 +65 @@\n+  dsimp only\n",
     "new": "  unfold chosenDecode\n  dsimp only\n",
     "old": "  unfold chosenDecode\n",
     "reason": "drafted proof never compiled: `unfold` leaves a `have` binder hiding the rewrite pattern; zeta-reduce with `dsimp only` (one line)"
    },
    {
     "diff": "--- LogicLineages/PersistentMarking/NumberedWindowInternalSparseDecodeEvaluationProof.lean\n+++ twin body\n@@ -73 +73,2 @@\n-    simp [h,(exactDecode n r (s-r)).mpr hp]\n+    simp [h]\n+    exact ((exactDecode n r (s-r)).mpr hp).symm\n",
     "new": "    simp [h]\n    exact ((exactDecode n r (s-r)).mpr hp).symm\n",
     "old": "    simp [h,(exactDecode n r (s-r)).mpr hp]\n",
     "reason": "drafted proof never compiled: exactDecode concerns the ArithmeticPair copy of decode; close the goal by `exact` up to the definitional equality of the two identical copies"
    },
    {
     "diff": "--- LogicLineages/PersistentMarking/NumberedWindowInternalSparseDecodeEvaluationProof.lean\n+++ twin body\n@@ -80 +80,2 @@\n-        rw [\u2190 hp,rootOfPair]\n+        rw [\u2190 hp]\n+        exact rootOfPair x y\n",
     "new": "        rw [\u2190 hp]\n        exact rootOfPair x y\n",
     "old": "        rw [\u2190 hp,rootOfPair]\n",
     "reason": "drafted proof never compiled: hp is stated for the ArithmeticPair copy of pair; `exact` instead of `rw`"
    },
    {
     "diff": "--- LogicLineages/PersistentMarking/NumberedWindowInternalSparseDecodeEvaluationProof.lean\n+++ twin body\n@@ -85 +85 @@\n-        simp [NumberedWindowPairAlgorithm.pair]\n+        simp [NumberedWindowArithmeticPair.pair]\n",
     "new": "        simp [NumberedWindowArithmeticPair.pair]\n",
     "old": "        simp [NumberedWindowPairAlgorithm.pair]\n",
     "reason": "drafted proof never compiled: the goal contains the ArithmeticPair copy of pair; unfold that name"
    }
