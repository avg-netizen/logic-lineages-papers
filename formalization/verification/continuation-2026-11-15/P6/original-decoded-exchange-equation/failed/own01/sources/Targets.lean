/-- The actual previous own-root table at stage rank(node), not its successor,
yields exactly the ordered standalone child answers. Coverage, nonmissingness,
rank-zero emptiness and child extraction are internal duties, not hypotheses. -/
def InternalPreviousAnswers : Prop := ∀ (n : Nat) (arity : Fin n → Nat)
    (body : Positive (Fin 1)) (alpha : Type) (Delta : List (Formula alpha))
    (node param rank old deps values : OTerm alpha),
  Nonempty (Derivation body Delta (graph2 (OriginalDecodedRank.rank n) rank node param)) →
  Nonempty (Derivation body Delta
    (graph3 (ExchangeGraphRecursion.graph (OriginalDecodedRank.rank n)
      (OriginalDecodedDependencies.dependencies n) (OriginalDecodedLayerCalibration.layer n arity)) old rank node param)) →
  Nonempty (Derivation body Delta (graph2 (OriginalDecodedDependencies.dependencies n) deps node param)) →
  (Nonempty (Derivation body Delta (graph2 (answerMap n arity) values deps param)) ↔
   Nonempty (Derivation body Delta (graph2 ExchangeMapGraph.mapGraph values deps old)))
/-- Genuine original recursive equation of the literal standalone selected AST.
Some(value) is a layer output, while exchange returns value itself, including0.
The complete ordered dependency answer list is generated by the concrete AST;
no recursive IH, cache agreement, native reflection or valid-input premise. -/
def InternalExchangeEquation : Prop := ∀ (n : Nat) (arity : Fin n → Nat)
    (body : Positive (Fin 1)) (alpha : Type) (Delta : List (Formula alpha))
    (node param values value : OTerm alpha),
  Nonempty (Derivation body Delta (graph2 (answers n arity) values node param)) →
  (Nonempty (Derivation body Delta (graph2 (exchange n arity) value node param)) ↔
   Nonempty (Derivation body Delta
    (graph3 (OriginalDecodedLayerCalibration.layer n arity) (suc value) node values param)))
end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.Continuation20261115.OriginalDecodedExchangeEquation.Targets
