module

public import LogicLineages.ModelsAlgebra.Differential.PolynomialDefinitions
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

@[expose] public section

/-!
# Actual fields generated by differential jets

These are the source semantics of `ℚ⟨a⟩` in paper 15, Definition
`def:constraint` and Lemma `lem:curve`. The field is the ordinary field
adjoin of every actual derivative of `a`. Its stability under the ambient
derivation is a theorem obligation, not a field in an assumed interface.
-/

namespace LogicLineages.ModelsAlgebra.Differential

variable {F : Type*} [Field F] [CharZero F]

def fieldGeneratedByJets (D : Derivation ℚ F F) (a : F) :
    IntermediateField ℚ F :=
  IntermediateField.adjoin ℚ (Set.range (jet D a))

def IsDerivationClosed (D : Derivation ℚ F F)
    (E : IntermediateField ℚ F) : Prop :=
  ∀ x ∈ E, D x ∈ E

end LogicLineages.ModelsAlgebra.Differential
