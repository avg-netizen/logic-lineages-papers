module

public import LogicLineages.ModelsAlgebra.Differential.GeneratedFieldDefinitions

@[expose] public section

/-!
# Constructing the differential field generated by one element

No closure or restriction supplier is assumed. Closure is proved by the
actual field-adjoin induction, including the inverse rule. Minimality
then follows by induction on the derivative index.
-/

namespace LogicLineages.ModelsAlgebra.Differential

variable {F : Type*} [Field F] [CharZero F]

theorem adjoin_isDerivationClosed (D : Derivation ℚ F F) (s : Set F)
    (hs : ∀ x ∈ s, D x ∈ IntermediateField.adjoin ℚ s) :
    IsDerivationClosed D (IntermediateField.adjoin ℚ s) := by
  let E := IntermediateField.adjoin ℚ s
  intro x hx
  refine IntermediateField.adjoin_induction ℚ (p := fun x _ => D x ∈ E) ?_ ?_ ?_ ?_ ?_ hx
  · intro y hy
    exact hs y hy
  · intro c
    rw [D.map_algebraMap]
    exact E.zero_mem
  · intro y z hy hz hDy hDz
    rw [map_add]
    exact E.add_mem hDy hDz
  · intro y hy hDy
    rw [D.leibniz_inv, smul_eq_mul]
    have hinv2 : y⁻¹ ^ (2 : ℕ) ∈ E := by
      simpa only [pow_two] using E.mul_mem (E.inv_mem hy) (E.inv_mem hy)
    exact E.mul_mem (E.neg_mem hinv2) hDy
  · intro y z hy hz hDy hDz
    rw [D.leibniz, smul_eq_mul, smul_eq_mul]
    exact E.add_mem (E.mul_mem hy hDz) (E.mul_mem hz hDy)

theorem fieldGeneratedByJets_isDerivationClosed (D : Derivation ℚ F F) (a : F) :
    IsDerivationClosed D (fieldGeneratedByJets D a) := by
  apply adjoin_isDerivationClosed
  rintro x ⟨n, rfl⟩
  exact IntermediateField.subset_adjoin ℚ _ ⟨n + 1, rfl⟩

theorem self_mem_fieldGeneratedByJets (D : Derivation ℚ F F) (a : F) :
    a ∈ fieldGeneratedByJets D a :=
  IntermediateField.subset_adjoin ℚ _ ⟨0, rfl⟩

theorem fieldGeneratedByJets_le (D : Derivation ℚ F F) (a : F)
    (E : IntermediateField ℚ F) (ha : a ∈ E) (hE : IsDerivationClosed D E) :
    fieldGeneratedByJets D a ≤ E := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro x ⟨n, rfl⟩
  induction n with
  | zero => exact ha
  | succ n hn => exact hE _ hn

/-- Restriction of a concrete derivation to an actually closed
intermediate field. The closure premise here is the genuine elementary
input condition, proved for the generated field immediately below. -/
def restrictDerivation (D : Derivation ℚ F F) (E : IntermediateField ℚ F)
    (hE : IsDerivationClosed D E) : Derivation ℚ E E where
  toLinearMap :=
    { toFun := fun x => ⟨D x, hE x x.property⟩
      map_add' := by
        intro x y
        apply Subtype.ext
        exact D.map_add x y
      map_smul' := by
        intro c x
        apply Subtype.ext
        exact D.map_smul c x }
  map_one_eq_zero' := by
    apply Subtype.ext
    exact D.map_one_eq_zero
  leibniz' := by
    intro x y
    apply Subtype.ext
    exact D.leibniz x y

@[simp] theorem restrictDerivation_apply (D : Derivation ℚ F F)
    (E : IntermediateField ℚ F) (hE : IsDerivationClosed D E) (x : E) :
    (restrictDerivation D E hE x : F) = D (x : F) := rfl

def generatedFieldDerivation (D : Derivation ℚ F F) (a : F) :
    Derivation ℚ (fieldGeneratedByJets D a) (fieldGeneratedByJets D a) :=
  restrictDerivation D _ (fieldGeneratedByJets_isDerivationClosed D a)

@[simp] theorem generatedFieldDerivation_apply (D : Derivation ℚ F F)
    (a : F) (x : fieldGeneratedByJets D a) :
    (generatedFieldDerivation D a x : F) = D (x : F) := rfl

end LogicLineages.ModelsAlgebra.Differential
