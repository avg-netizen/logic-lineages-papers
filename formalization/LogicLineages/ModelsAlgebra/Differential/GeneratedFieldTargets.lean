module

public import LogicLineages.ModelsAlgebra.Differential.GeneratedFieldDefinitions

@[expose] public section

/-!
Independent fixed obligations for the actual field generated by jets.
The source's smallest differential subfield is not taken as an input
supplier; the candidate must construct closure, restriction and minimality.
-/

namespace LogicLineages.ModelsAlgebra.Differential.Targets

universe u

def jetFieldClosed : Prop :=
  ∀ (F : Type u) [Field F] [CharZero F] (D : Derivation ℚ F F) (a : F),
    IsDerivationClosed D (fieldGeneratedByJets D a)

def jetFieldMinimal : Prop :=
  ∀ (F : Type u) [Field F] [CharZero F] (D : Derivation ℚ F F) (a : F)
    (E : IntermediateField ℚ F),
    a ∈ E → IsDerivationClosed D E → fieldGeneratedByJets D a ≤ E

def jetFieldRestriction : Prop :=
  ∀ (F : Type u) [Field F] [CharZero F] (D : Derivation ℚ F F) (a : F),
    ∃ d : Derivation ℚ (fieldGeneratedByJets D a) (fieldGeneratedByJets D a),
      ∀ x, (d x : F) = D (x : F)

end LogicLineages.ModelsAlgebra.Differential.Targets
