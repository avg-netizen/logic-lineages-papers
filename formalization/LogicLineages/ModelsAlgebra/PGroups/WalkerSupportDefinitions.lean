module
public import LogicLineages.ModelsAlgebra.PGroups.WalkerNormalDefinitions
@[expose] public section
namespace LogicLineages.ModelsAlgebra.PGroups

/-- Actual subgroup generated by the source nodes whose last ordinal is at
least α, exactly the right side of source equation walker-filtration. -/
def walkerHeightSpan (p : ℕ) (ξ α : Ordinal.{0}) : AddSubgroup (WalkerSourceGroup p ξ) :=
  AddSubgroup.closure (walkerPresentedGenerator p (walkerOrdinalParent ξ) ''
    {s : WalkerOrdinalNode ξ | α ≤ walkerOrdinalHeight ξ s})

end LogicLineages.ModelsAlgebra.PGroups
