module

public import Mathlib.Algebra.Group.End
public import Mathlib.Algebra.Group.Hom.End

@[expose] public section
namespace LogicLineages.ModelsAlgebra.PGroups.GroupInfinitary

/-- Actual transition maps of the sequential system generated by f.
The order proof supplies the directed-system domain, not an algebraic oracle. -/
def iterationTransition {G : Type*} [AddCommGroup G] (f : G →+ G)
    (i j : ℕ) (_h : i ≤ j) : G →+ G :=
  (AddMonoid.End.instMonoid G).npow (j - i) f

end LogicLineages.ModelsAlgebra.PGroups.GroupInfinitary
