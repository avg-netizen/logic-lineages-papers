module

public import LogicLineages.ModelsAlgebra.PGroups.InfinitaryDefinitions
public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.Algebra.Group.Equiv.Defs
public import Mathlib.SetTheory.Ordinal.Arithmetic

@[expose] public section

/-! Actual finite generated subgroups and Scott categoricity for paper01's
locally finite Sigma_2 obstruction (lines 216–221). These are semantic
properties, not assumed theorem suppliers. -/
namespace LogicLineages.ModelsAlgebra.PGroups.GroupInfinitary

universe u

/-- Every subgroup generated by a finite tuple is genuinely finite. -/
def LocallyFinite (G : Type u) [AddCommGroup G] : Prop :=
  ∀ (n : ℕ) (a : Fin n → G),
    Set.Finite (AddSubgroup.closure (Set.range a) : Set G)

/-- Self-truth and categoricity among all countable additive commutative
groups in the same universe, INCLUDING finite groups. This is a relative
Scott property: an unrestricted Scott sentence necessarily has this property,
so proving its impossibility supplies an unrestricted Scott obstruction too.
No countability, infinitude, complexity, or classification is built in. -/
def GroupScottSentence (G : Type u) [AddCommGroup G] (φ : Formula 0) : Prop :=
  φ.Realize (Fin.elim0 : Fin 0 → G) ∧
    ∀ (H : Type u) [AddCommGroup H] [Countable H],
      φ.Realize (Fin.elim0 : Fin 0 → H) → Nonempty (G ≃+ H)

end LogicLineages.ModelsAlgebra.PGroups.GroupInfinitary
