/-- Literal effective-leaf identity at the SAME selected Data. The neutral
endpoint used by both wrapper layers is the original final selectedEndpoint;
the entire original oldStep and window survive. This is Program AST equality,
not equality of evaluations, and does not identify the literal decoder AST. -/
def ActualFinalClosedLeafIdentity : Prop :=
  ∀ p : GlobalSourcePackage.Inputs,
  (OriginalLambdaTraversalSelection.finalInputs p).oldStep =
    OriginalHereditaryLambdaGlobal.closedLeaf
      (InternalParameterizedStructuralEndpointGuard.selectedEndpoint
        (OriginalLambdaTraversalSelection.finalData p)) p.window p.oldStep

