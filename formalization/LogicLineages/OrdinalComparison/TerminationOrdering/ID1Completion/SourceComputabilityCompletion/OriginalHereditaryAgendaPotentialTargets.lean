module
public import LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalHereditaryAgendaPotentialDefinitions
public import LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalHereditaryBudgetSumTargets
public import LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.InternalListCodecSupportProof
@[expose] public section
namespace LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalHereditaryAgendaPotentialTargets
open FirstOrder Language PositiveArithmeticOperators InternalCalculus InternalControlGraph
open InternalGraphComposition (OTerm)
open InternalApplicationCertificateConstructors
open InternalTagArithmeticSyntaxProof (z suc)
open InternalOriginalOrderSyntaxProof (ltF)
open InternalAdditionLawsProof (add)
open InternalListCodecSupportProof (consGraph)
def Append : Prop := ∀ (body : Positive (Fin 1)) (alpha : Type) (Delta : List (Formula alpha))
 (front suffix joined branching a b : OTerm alpha),
 Nonempty (Derivation body Delta (graph2 InternalApplicationValidityStackAppend.append joined front suffix)) →
 Nonempty (Derivation body Delta (graph2 OriginalHereditaryAgendaPotential.agenda a front branching)) →
 Nonempty (Derivation body Delta (graph2 OriginalHereditaryAgendaPotential.agenda b suffix branching)) →
 Nonempty (Derivation body Delta (graph2 OriginalHereditaryAgendaPotential.agenda (add a b) joined branching))
def Tagged : Prop := ∀ (body : Positive (Fin 1)) (alpha : Type) (Delta : List (Formula alpha))
 (jobs tagged branching total : OTerm alpha),
 Nonempty (Derivation body Delta (graph1 OriginalHereditaryVisitScheduler.tagVisits tagged jobs)) →
 Nonempty (Derivation body Delta (graph2 OriginalHereditaryBudgetSum.sum total jobs branching)) →
 Nonempty (Derivation body Delta (graph2 OriginalHereditaryAgendaPotential.agenda (add total total) tagged branching))
/-- Literal supported return frame removal. The target is the agenda effect,
not a claim that arbitrary malformed runtime return states take this step. -/
def ReturnPop : Prop := ∀ (body : Positive (Fin 1)) (alpha : Type) (Delta : List (Formula alpha))
 (frame payload work rest branching before after : OTerm alpha),
 Nonempty (Derivation body Delta (graph2 InternalPairing.pairing frame (suc z) payload)) →
 Nonempty (Derivation body Delta (consGraph work frame rest)) →
 Nonempty (Derivation body Delta (graph2 OriginalHereditaryAgendaPotential.agenda before work branching)) →
 Nonempty (Derivation body Delta (graph2 OriginalHereditaryAgendaPotential.agenda after rest branching)) →
 Nonempty (Derivation body Delta (ltF after before))
/-- Exact visit agenda replacement generated by the existing scheduler:
visits(expansion parent) ++ return(parent)::rest. No result-stack or full
runtime completion conclusion is asserted by this local potential theorem. -/
def VisitReplacement : Prop := ∀ (body : Positive (Fin 1)) (alpha : Type) (Delta : List (Formula alpha))
 (parent visit returnFrame returnPayload jobs tagged rest work returnRest next branching weight before after : OTerm alpha),
 Nonempty (Derivation body Delta (graph2 InternalPairing.pairing visit z parent)) →
 Nonempty (Derivation body Delta (graph2 InternalPairing.pairing returnFrame (suc z) returnPayload)) →
 Nonempty (Derivation body Delta (consGraph work visit rest)) →
 Nonempty (Derivation body Delta (consGraph returnRest returnFrame rest)) →
 Nonempty (Derivation body Delta (graph1 OriginalHereditaryAnnotatedExpansion.expansion jobs parent)) →
 Nonempty (Derivation body Delta (graph1 OriginalHereditaryVisitScheduler.tagVisits tagged jobs)) →
 Nonempty (Derivation body Delta (graph2 InternalApplicationValidityStackAppend.append next tagged returnRest)) →
 Nonempty (Derivation body Delta (graph1 OriginalHereditaryFuelProgram.weight weight parent)) →
 Nonempty (Derivation body Delta (ltF (suc (suc weight)) (suc branching))) →
 Nonempty (Derivation body Delta (graph2 OriginalHereditaryAgendaPotential.agenda before work branching)) →
 Nonempty (Derivation body Delta (graph2 OriginalHereditaryAgendaPotential.agenda after next branching)) →
 Nonempty (Derivation body Delta (ltF after before))
end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalHereditaryAgendaPotentialTargets
