/-- Actual original packed weakening preserves the NEW active Domain at the
actual extended parameter. Arbitrary literal Insert geometry, SAME outer c,
no inserted-type membership/window premise or desired shifted admission.
This is source/window closure, not E preservation or Object cancellation. -/
def ActualShiftDomain : Prop :=
 ∀ (p : GlobalSourcePackage.Inputs) (H G : Program 1) (W : Program 2)
 (body : Positive (Fin 1)) (alpha : Type) (Delta : List (Formula alpha))
 (packed shifted d cutoff gamma extended c parameter extendedParameter : OTerm alpha),
 Nonempty (Derivation body Delta (Domain p H G W packed parameter)) →
 Nonempty (Derivation body Delta (OriginalContextInsertion.Insert d cutoff gamma extended)) →
 Nonempty (Derivation body Delta (graph2 InternalPairing.pairing parameter c gamma)) →
 Nonempty (Derivation body Delta (graph2 InternalPairing.pairing extendedParameter c extended)) →
 Nonempty (Derivation body Delta (graph2 OriginalRawSyntaxTransport.shiftPackedRaw shifted cutoff packed)) →
 Nonempty (Derivation body Delta (Domain p H G W shifted extendedParameter))
end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.SixSol20261113.Context.EvaluatorKeyShiftDomainTargets
