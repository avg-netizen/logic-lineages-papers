@[simp] theorem resultRename {alpha beta : Type} (raw needle bit rest : OTerm alpha) (j : alpha → beta) :
    (result raw needle bit rest).relabel j =
      result (raw.relabel j) (needle.relabel j) (bit.relabel j) (rest.relabel j) := by
  rw [formulaRelabelAsSubst]
  change (result raw needle bit rest).subst (fun a => emb (.var (j a))) = _
  rw [resultSubst]
  simp only [← termRelabelAsSubst]
