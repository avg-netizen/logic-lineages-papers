/-- Literal initial tuple installation only; native calibration cannot transport internal derivations. W remains the explicitly calibrated window. -/
def ConcreteInitialTuple : Prop := ∀ (n : Nat) (arity : Fin n → Nat)
    (p : GlobalSourcePackage.Inputs) (W : Program 2),
  GlobalSourcePackage.InputsCalibrated n arity p →
  OriginalUniverseDecoder.HeadWindowCalibrated n arity W →
  let H := OriginalConcreteHeadSignature.signature n arity
  let G := OriginalDecodedContextValidity.contextGuard n
  let T := OriginalTypedDecoder.target H G
  let Q := OriginalCandidates.candidates n arity H
  let E := OriginalConcreteStructuralEdge.edge n arity
  let L := SeededPrimaryPool.primary T Q E
  let D := TransparentCandidate.candidate T
  let q := Membership.inputs p H G L D
  Membership.ListCalibrated n arity L ∧
  (∀ v : List.Vector Nat 2, evaluate q.base.oldRepresentative v =
    evaluate p.base.oldRepresentative v) ∧
  GlobalSourcePackage.InputsCalibrated n arity q ∧
  OriginalRankGuardedRepresentative.Properties n arity q H G W
end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.Continuation20261117.OriginalConcreteInitialInstallation.Targets
