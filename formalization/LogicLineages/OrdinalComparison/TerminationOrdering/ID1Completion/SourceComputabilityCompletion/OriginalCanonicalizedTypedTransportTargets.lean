module
public import LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalCanonicalizedTypedTransportDefinitions
@[expose] public section
namespace LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalCanonicalizedTypedTransportTargets
open UniformCertificateCompletion
open OriginalTransparentDecoderValidatorCollapse OriginalCanonicalizedTypedTransport
open LogicLineages.ComputabilityKnowledge.GorbowPRProgram

/-- One q=transparentInputs H G W p, one r=refineInputs G q and exactly
finalData r are retained for the typed input and canonicalized output. -/
def ActualOriginalCanonicalizedTypedPackedWeakening : Prop :=
  ∀ (p : GlobalSourcePackage.Inputs) (H G : Program 1) (W : Program 2),
    PackedWeakening (selected p H G W)

/-- SAME-final canonicalized erasure, with no extra source-window,
erased-type membership, canonicality or transformed fixedness premise. -/
def ActualOriginalCanonicalizedTypedPackedErasure : Prop :=
  ∀ (p : GlobalSourcePackage.Inputs) (H G : Program 1) (W : Program 2),
    PackedErasure (selected p H G W)

end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalCanonicalizedTypedTransportTargets
