def fields {alpha : Type} (raw left right needle lc rc : OTerm alpha) : Formula alpha :=
  graph3 ArgumentCountComparison.allCounts (numeral 1) raw left right ⊓
  graph2 contains (numeral 1) raw needle ⊓
  graph2 ArgumentEntryCount.count lc left needle ⊓
  graph2 ArgumentEntryCount.count rc right needle
def result {alpha : Type} (raw left right needle lc rc : OTerm alpha) : Formula alpha := eqn lc rc
def matrix {alpha : Type} (raw : OTerm alpha) : Formula (alpha ⊕ Fin 5) :=
  (fields (raw.relabel Sum.inl) (.var (.inr 0)) (.var (.inr 1)) (.var (.inr 2)) (.var (.inr 3)) (.var (.inr 4))).imp
  (result (raw.relabel Sum.inl) (.var (.inr 0)) (.var (.inr 1)) (.var (.inr 2)) (.var (.inr 3)) (.var (.inr 4)))
def AtRaw {alpha : Type} (raw : OTerm alpha) : Formula alpha := InternalClosedPrograms.allBlock (matrix raw)
def rawPredicate {alpha : Type} : Formula (alpha ⊕ Fin 1) := AtRaw (.var (.inr 0))
def BelowRaw {alpha : Type} (raw : OTerm alpha) : Formula alpha := InternalStrongInduction.below (rawPredicate) raw
end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.Continuation20261115.OriginalArgumentPermutationClosure.SupportedInductionDefinitions
