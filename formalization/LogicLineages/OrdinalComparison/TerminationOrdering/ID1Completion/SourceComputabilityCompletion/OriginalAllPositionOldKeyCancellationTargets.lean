/-- Honest old-key cancellation across the actual final fold at an inserted
cutoff. Concrete lookup/deletion and parameter graphs retain the runtime
contexts. The old acyclic key and raw rank transfer; equality of final C
outputs, canonical Objects, or iterated-deletion signatures is NOT claimed. -/
def ActualCancellation : Prop :=
 ∀ (p : GlobalSourcePackage.Inputs) (H G : Program 1) (W : Program 2) (P : Program 3)
 (body : Positive (Fin 1)) (alpha : Type) (Delta : List (Formula alpha))
 (input shifted out erased typ parameter insertedParameter context gamma extended erasedType cutoff keyValue rank : OTerm alpha),
 Nonempty (Derivation body Delta ((OriginalFunctionNeutrality.windowGraph (OriginalLambdaTraversalSelection.finalInputs (refined p H G W P)).window shifted insertedParameter ⊓ (InternalParameterizedCanonicalResultFold.sourcePremises (OriginalLambdaTraversalSelection.finalData (refined p H G W P)) shifted typ insertedParameter ⊓ InternalParameterizedCanonicalResultFold.foldGraph (OriginalLambdaTraversalSelection.finalData (refined p H G W P)) out shifted insertedParameter)))) →
 Nonempty (Derivation body Delta (OriginalIndexedObserverDefinitions.ActualRange cutoff insertedParameter)) →
 Nonempty (Derivation body Delta (graph2 InternalPairing.pairing parameter context gamma)) →
 Nonempty (Derivation body Delta (graph2 InternalPairing.pairing insertedParameter context extended)) →
 Nonempty (Derivation body Delta (graph2 InternalRawListRecursion.lookup erasedType cutoff extended)) →
 Nonempty (Derivation body Delta (graph2 OriginalClassContextAllPositionObserver.deleteAt gamma cutoff extended)) →
 Nonempty (Derivation body Delta (graph2 OriginalRawSyntaxTransport.shiftPackedRaw shifted cutoff input)) →
 Nonempty (Derivation body Delta (graph3 OriginalRawSyntaxTransport.erasePackedRaw erased erasedType cutoff out)) →
 Nonempty (Derivation body Delta (graph2 (OriginalStructuralClassKeyDefinitions.key p H G W) keyValue input parameter)) →
 Nonempty (Derivation body Delta (graph1 OriginalRawSyntaxTransport.variableRankPackedRaw rank input)) →
 Nonempty (Derivation body Delta (graph2 (OriginalStructuralClassKeyDefinitions.key p H G W) keyValue erased parameter ⊓ graph1 OriginalRawSyntaxTransport.variableRankPackedRaw rank erased))

end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalAllPositionOldKeyCancellationTargets
