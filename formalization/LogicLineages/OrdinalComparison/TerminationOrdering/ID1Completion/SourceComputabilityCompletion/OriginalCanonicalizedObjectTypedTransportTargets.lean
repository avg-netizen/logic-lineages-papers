module
public import LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalCanonicalizedObjectTypedTransportDefinitions
@[expose] public section
namespace LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalCanonicalizedObjectTypedTransportTargets
open UniformCertificateCompletion OriginalCanonicalizedObjectTypedTransport
open LogicLineages.ComputabilityKnowledge.GorbowPRProgram

/-- One transparent tuple, one original variable refinement and one unchanged
final tuple, for every input Object and actual shifted canonical output. -/
def ActualOriginalCanonicalizedObjectTypedWeakening : Prop :=
  ∀ (p : GlobalSourcePackage.Inputs) (H G : Program 1) (W : Program 2),
    Weakening p H G W

/-- The actual erased Object and actual canonical Object output are retained;
the original nonempty context is an explicit arithmetic premise. -/
def ActualOriginalCanonicalizedObjectTypedErasure : Prop :=
  ∀ (p : GlobalSourcePackage.Inputs) (H G : Program 1) (W : Program 2),
    Erasure p H G W

end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalCanonicalizedObjectTypedTransportTargets
