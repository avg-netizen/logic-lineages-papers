/-- Original tag 4 equation of the same installed optional AST. HeadMove
and decoded-field correctness remain explicit unpaid supplier obligations. -/
def InternalOrdinary : Prop := ∀ (body : Positive (Fin 1)) (alpha : Type)
    (Delta : List (Formula alpha)) (U : Fin 19 → Program 3) (V : Program 3)
    (node code param h0 t0 : OTerm alpha) (xs : Fin 19 → OTerm alpha),
  Nonempty (Derivation body Delta (graph3 V (numeral 1) node code param)) →
  (∀ i, Nonempty (Derivation body Delta
    (graph3 (TransparentExchangeLayer.fields U i) (xs i) node code param))) →
  Nonempty (Derivation body Delta (eqn (xs 0) (numeral 4))) →
  Nonempty (Derivation body Delta (eqn (xs 7) (numeral 4))) →
  Nonempty (Derivation body Delta (graph2 InternalListCodec.consCode code h0 t0)) →
  (Nonempty (Derivation body Delta
      (graph3 (TransparentExchangeLayer.optional U V) (numeral 2) node code param)) ↔
   Nonempty (Derivation body Delta ((eqn (xs 16) (numeral 1) ⊓ eqn (xs 18) (xs 17)) ⊔
     (eqn (xs 2) (xs 9) ⊓ eqn h0 (numeral 1)))))
/-- Original tag 5 equation of the same installed optional AST. HeadMove
and decoded-field correctness remain explicit unpaid supplier obligations. -/
def InternalNumbered : Prop := ∀ (body : Positive (Fin 1)) (alpha : Type)
    (Delta : List (Formula alpha)) (U : Fin 19 → Program 3) (V : Program 3)
    (node code param h0 t0 h1 t1 h2 t2 h3 t3 : OTerm alpha) (xs : Fin 19 → OTerm alpha),
  Nonempty (Derivation body Delta (graph3 V (numeral 1) node code param)) →
  (∀ i, Nonempty (Derivation body Delta
    (graph3 (TransparentExchangeLayer.fields U i) (xs i) node code param))) →
  Nonempty (Derivation body Delta (eqn (xs 0) (numeral 5))) →
  Nonempty (Derivation body Delta (eqn (xs 7) (numeral 5))) →
  Nonempty (Derivation body Delta (graph2 InternalListCodec.consCode code h0 t0)) →
  Nonempty (Derivation body Delta (graph2 InternalListCodec.consCode t0 h1 t1)) →
  Nonempty (Derivation body Delta (graph2 InternalListCodec.consCode t1 h2 t2)) →
  Nonempty (Derivation body Delta (graph2 InternalListCodec.consCode t2 h3 t3)) →
  (Nonempty (Derivation body Delta
      (graph3 (TransparentExchangeLayer.optional U V) (numeral 2) node code param)) ↔
   Nonempty (Derivation body Delta ((eqn (xs 3) (xs 10) ⊓ (eqn (xs 1) (xs 8) ⊓ eqn (xs 4) (xs 11))) ⊓
     (((eqn (xs 6) (xs 13) ⊓ eqn (xs 16) (numeral 1)) ⊔
       ((eqn (xs 2) (xs 9) ⊓ eqn (xs 6) (xs 13)) ⊓ eqn h0 (numeral 1))) ⊔
      ((eqn (xs 2) (xs 9) ⊓ eqn (xs 5) (xs 12)) ⊓ eqn h3 (numeral 1))))))
