theorem matrixSchemaWitness {alpha : Type} (A : {gamma : Type} → OTerm gamma → OTerm gamma → Formula gamma) (weight : Program 1) (hA : ∀ {a b : Type} (l r : OTerm a) (s : a → OTerm b), (A l r).subst (fun x => emb (s x)) = A (l.subst s) (r.subst s)) (left right ls rs : OTerm alpha) :
    (matrixSchema A weight left).subst (Sum.elim Term.var (fun i => emb (![right,ls,rs] i))) =
      (fieldsSchema A weight left right ls rs).imp (eqn ls rs) := by
  have he : (Sum.elim Term.var (fun i => emb (![right,ls,rs] i))) =
      (fun a => emb (Sum.elim Term.var ![right,ls,rs] a)) := by
    funext a; cases a <;> rfl
  unfold matrixSchema
  rw [he]
  simp only [impSubst,fieldsSchemaSubst A weight hA,eqnSubst,witnessLift,Term.subst,Sum.elim_inr]
  rfl

