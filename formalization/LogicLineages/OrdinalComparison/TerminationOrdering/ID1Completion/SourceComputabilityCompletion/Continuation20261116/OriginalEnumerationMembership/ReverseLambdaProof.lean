theorem atConstructor (n : Nat) (bound fuel types heads labels tupleBound opened raw typ child : OTerm alpha)
    (hi : Nonempty (Derivation body Delta (Lists.Characterizes n opened (suc bound) fuel types heads labels tupleBound)))
    (hc : Nonempty (Derivation body Delta (graph2 lambdaConstructor raw typ child)))
    (h : Nonempty (Derivation body Delta (Meaning.holds n raw bound (suc fuel) types heads labels tupleBound))) :
    Nonempty (Derivation body Delta (OriginalEnumerationLayerFields.Targets.lambdaCase types opened raw)) := by
  have hf := (UnaryMeaningProof.lambdaCase n raw bound fuel types heads labels tupleBound typ child hc).mp h
  have hm := (ListBindingProof.atRaw n opened (suc bound) fuel types heads labels tupleBound child hi).mpr
    (andRight (andRight hf))
  exact OriginalEnumerationLayerFields.LambdaSyntaxProof.introduce types opened raw ![typ,child]
    (andIntro (andIntro (andLeft (andRight hf)) hm) hc)
end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.Continuation20261116.OriginalEnumerationMembership.ReverseLambdaProof
