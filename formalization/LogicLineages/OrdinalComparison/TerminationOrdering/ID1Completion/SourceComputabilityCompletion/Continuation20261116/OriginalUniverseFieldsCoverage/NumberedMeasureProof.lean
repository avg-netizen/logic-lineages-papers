open InternalAdditionLawsProof (add)

theorem atValues (n : Nat)
    (raw rootLabel head typ left types right pair size label lv ls ll rv rs rl childLabel maximum canonical : OTerm alpha)
    (hc : Nonempty (Derivation body Delta (programGraph OriginalRawSyntaxTransport.numberedConstructor raw ![rootLabel,head,typ,left,types,right])))
    (hg : Nonempty (Derivation body Delta (graph1 (OriginalCodeValidityGuard.check n) (numeral 1) raw)))
    (hb : Nonempty (Derivation body Delta (graph1 (OriginalCodeBoundsRecursion.bounds n) pair raw)))
    (hp : Nonempty (Derivation body Delta (graph2 InternalPairing.pairing pair size label)))
    (hlb : Nonempty (Derivation body Delta (graph1 (OriginalCodeBoundsRecursion.bounds n) lv left)))
    (hlp : Nonempty (Derivation body Delta (graph2 InternalPairing.pairing lv ls ll)))
    (hrb : Nonempty (Derivation body Delta (graph1 (OriginalCodeBoundsRecursion.bounds n) rv right)))
    (hrp : Nonempty (Derivation body Delta (graph2 InternalPairing.pairing rv rs rl)))
    (hm : Nonempty (Derivation body Delta (graph2 OriginalBoundsRecombination.maximum childLabel ll rl)))
    (hmax : Nonempty (Derivation body Delta (graph2 OriginalBoundsRecombination.maximum maximum rootLabel childLabel)))
    (hk : Nonempty (Derivation body Delta (graph2 InternalPairing.pairing canonical (suc (add ls rs)) maximum))) :
    Nonempty (Derivation body Delta (eqn size (suc (add ls rs)) ⊓ eqn label maximum)) := by
  have hv := OriginalCodeBoundsConstructors.NumberedValueProof.value n raw rootLabel head typ left types right
    lv ls ll rv rs rl childLabel maximum canonical hc hg hlb hrb hlp hrp hm hmax hk
  exact andIntro (BoundsMeasureProof.measuredSize n raw pair size label canonical (suc (add ls rs)) maximum hb hp hv hk)
    (BoundsMeasureProof.measuredLabel n raw pair size label canonical (suc (add ls rs)) maximum hb hp hv hk)

end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.Continuation20261116.OriginalUniverseFieldsCoverage.NumberedMeasureProof
