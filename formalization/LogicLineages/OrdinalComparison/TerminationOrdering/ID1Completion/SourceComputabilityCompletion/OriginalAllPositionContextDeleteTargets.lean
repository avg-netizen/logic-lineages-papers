open FirstOrder Language PositiveArithmeticOperators InternalCalculus InternalControlGraph
open InternalGraphComposition (OTerm)
open InternalApplicationCertificateConstructors
/-- Actual selector geometry, independently inside arithmetic. The literal
forward-prefix/deleteAt and lookup Programs are used. No decoded-list,
calibration, class-hit, source, or insertion premise is supplied. -/
def ActualDeletionInsertion : Prop :=
  ∀ (body : Positive (Fin 1)) (alpha : Type) (Delta : List (Formula alpha))
    (count gamma cutoff deleted d : OTerm alpha),
  Nonempty (Derivation body Delta
    ((OriginalContextInsertion.lengthGraph count gamma ⊓
      (OriginalContextInsertion.Below cutoff count ⊓
      (graph2 OriginalClassContextAllPositionObserver.deleteAt deleted cutoff gamma ⊓
       graph2 InternalRawListRecursion.lookup d cutoff gamma))).imp
      (OriginalContextInsertion.Insert d cutoff deleted gamma)))
end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalAllPositionContextDeleteTargets
