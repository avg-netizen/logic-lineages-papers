open LogicLineages.ComputabilityKnowledge.GorbowPRProgram
variable {body : Positive (Fin 1)} {alpha : Type} {Gamma : List (Formula alpha)}

/-- Every singleton-root witness is generated by the unchanged constructor
programs. The initial state, connected frame and actual payload are exposed
together, with no caller-supplied run or frame decomposition. -/
theorem rootFrameCases (raw parameter : OTerm alpha) (psi : Formula alpha)
    (step : ∀ (beta : Type) (j : alpha → beta) (Delta : List (Formula beta))
      (state workCode frame payload : OTerm beta), (∀ p ∈ Gamma, p.relabel j ∈ Delta) →
      Nonempty (Derivation body Delta (graph2 initial state (raw.relabel j) (parameter.relabel j))) →
      Nonempty (Derivation body Delta
        (StateFrame state workCode frame (raw.relabel j) (parameter.relabel j) z)) →
      Nonempty (Derivation body Delta (graph1 InternalUnpair.right payload (raw.relabel j))) →
      Nonempty (Derivation body Delta (psi.relabel j))) :
    Nonempty (Derivation body Gamma psi) := by
  let frameProgram : Program 2 := pairOf (.projection 0) (.projection 1)
  let workProgram : Program 2 := consOf frameProgram (InternalAcceptance.constantZero 2)
  let qs : Fin 4 → Program 2 := ![frameProgram,workProgram,initial,rightOf (.projection 0)]
  let xs : Fin 2 → OTerm alpha := Fin.cons raw (Fin.cons parameter Fin.elim0)
  apply queryCases qs xs psi
  intro beta j ys Delta hj hq
  simp only [xs,consTermRename,emptyRename] at hq
  let xx : Fin 2 → OTerm beta := Fin.cons (raw.relabel j) (Fin.cons (parameter.relabel j) Fin.elim0)
  have hf := binaryRecover InternalPairing.pairing (.projection 0) (.projection 1)
    (ys 0) (raw.relabel j) (parameter.relabel j) xx (hq 0)
    (projectionValue 0 xx) (projectionValue 1 xx)
  have hw := binaryRecover InternalListCodec.consCode frameProgram (InternalAcceptance.constantZero 2)
    (ys 1) (ys 0) z xx (hq 1) (hq 0) (InternalLessThanSupportProof.zeroConstantValue xx)
  have hs := binaryRecover InternalPairing.pairing (InternalLessThan.constantOne 2) workProgram
    (ys 2) (numeral 1) (ys 1) xx (hq 2) (InternalLessThanSupportProof.oneConstantValue xx) (hq 1)
  have hp := unaryRecover InternalUnpair.right (.projection 0) (ys 3) (raw.relabel j) xx
    (hq 3) (projectionValue 0 xx)
  exact step beta j Delta (ys 2) (ys 1) (ys 0) (ys 3) hj (hq 2)
    (andIntro hs (andIntro hw hf)) hp

end LogicLineages.OrdinalComparison.TerminationOrdering.ID1Completion.SourceComputabilityCompletion.OriginalHereditaryValidityInternalRecurrenceRootFrameProof
