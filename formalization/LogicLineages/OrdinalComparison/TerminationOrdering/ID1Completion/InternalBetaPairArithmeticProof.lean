def oneMul (t : OTerm α) : Derivation body Gamma (eqn (mul (suc z) t) t) :=
  InternalTagArithmeticSupportProof.trans (leftSuccessorMultiplication z t)
    (InternalTagArithmeticSupportProof.trans (congAddRight t (multiplicationLeftZero t)) (leftZero t))
def twoMul (t : OTerm α) : Derivation body Gamma (eqn (mul (suc (suc z)) t) (twice t)) :=
  InternalTagArithmeticSupportProof.trans (leftSuccessorMultiplication (suc z) t) (congAddRight t (oneMul t))

