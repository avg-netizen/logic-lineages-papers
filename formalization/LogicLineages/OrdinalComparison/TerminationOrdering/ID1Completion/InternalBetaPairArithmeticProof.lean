def pairEquation (x y : OTerm α) : Derivation body Gamma
    (eqn (firstCode x y) (add (mul (secondQuotient y) (suc (twice (secondCode x y)))) y)) := by
  let a := twice y
  let s := secondCode x y
  let p := mul a s
  have hl : Derivation body Gamma
      (eqn (firstCode x y) (suc (add (add (add (add p p) s) (add a a)) x))) :=
    InternalTagArithmeticSupportProof.trans (congAddRight x (mulSucc (suc (add a a)) s))
      (InternalTagArithmeticSupportProof.trans (congAddRight x (congAddRight (suc (add a a)) (leftSuccessorMultiplication (add a a) s)))
        (InternalTagArithmeticSupportProof.trans (congAddRight x (congAddRight (suc (add a a)) (congAddRight s (leftDistributivity a a s))))
          (InternalTagArithmeticSupportProof.trans (congAddRight x (addSucc (add (add p p) s) (add a a)))
            (leftSuccessor (add (add (add p p) s) (add a a)) x))))
  have hr : Derivation body Gamma
      (eqn (add (mul (secondQuotient y) (suc (twice s))) y)
        (suc (add (add (add (add p p) (add s s)) a) y))) :=
    InternalTagArithmeticSupportProof.trans (congAddRight y (mulSucc (suc a) (add s s)))
      (InternalTagArithmeticSupportProof.trans (congAddRight y (congAddRight (suc a) (leftSuccessorMultiplication a (add s s))))
        (InternalTagArithmeticSupportProof.trans (congAddRight y (congAddRight (suc a) (congAddRight (add s s) (distributivity a s s))))
          (InternalTagArithmeticSupportProof.trans (congAddRight y (addSucc (add (add p p) (add s s)) a))
            (leftSuccessor (add (add (add p p) (add s s)) a) y))))
  exact InternalTagArithmeticSupportProof.trans hl (InternalTagArithmeticSupportProof.trans (congSuc (rearrangePair p x y)) (InternalTagArithmeticSupportProof.symm hr))

