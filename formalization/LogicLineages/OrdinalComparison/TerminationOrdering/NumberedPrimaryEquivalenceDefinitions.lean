module
public import LogicLineages.OrdinalComparison.TerminationOrdering.NumberedRewriteApplicationPathProof

@[expose] public section
/-! The primary equivalence is the congruence generated by equivalent-head
exchange and typed BASE permutations. Labels, result types and ordered extras
are retained. Its motion is ZERO cost, never a positive auxiliary reduction.
This unconfined presentation does not assert finite classes: the source's
fixed-type universe and its computable least-code representatives remain
separate obligations. In particular native head annotations are not bounded
merely by fixing the retyped output of a numbered head.
-/
namespace LogicLineages.OrdinalComparison.TerminationOrdering.NumberedPrimaryEquivalence
open Source Source.SourceMarkedSyntax NumberedRewriteSyntax NumberedRewriteReduction

mutual
inductive Primary (Symbol : Type) (arity : Symbol → Nat) :
    (Gamma : List Ty) → Packed Symbol arity Gamma → Packed Symbol arity Gamma → Prop where
  | refl {Gamma} (q : Packed Symbol arity Gamma) : Primary Symbol arity Gamma q q
  | symm {Gamma} {q r : Packed Symbol arity Gamma} :
      Primary Symbol arity Gamma q r → Primary Symbol arity Gamma r q
  | trans {Gamma} {q r s : Packed Symbol arity Gamma} :
      Primary Symbol arity Gamma q r → Primary Symbol arity Gamma r s → Primary Symbol arity Gamma q s
  | ordinary {Gamma} (f g : Head Symbol)
      (base : AuxArguments Symbol arity Gamma (headArguments arity f))
      (target : AuxArguments Symbol arity Gamma (headArguments arity g)) :
      RecursiveComparison.headEquivalent f g → headResult f=headResult g →
      (argumentList base).Perm (argumentList target) →
      Primary Symbol arity Gamma ⟨headResult f,.ordinary f base⟩ ⟨headResult g,.ordinary g target⟩
  | numbered {Gamma} (k : Nat) (f g : Head Symbol) (tau : Ty)
      (base : AuxArguments Symbol arity Gamma (headArguments arity f))
      (target : AuxArguments Symbol arity Gamma (headArguments arity g))
      (types : List Ty) (extras : AuxArguments Symbol arity Gamma types) :
      RecursiveComparison.headEquivalent f g → (argumentList base).Perm (argumentList target) →
      Primary Symbol arity Gamma ⟨tau,.numbered k f tau base types extras⟩ ⟨tau,.numbered k g tau target types extras⟩
  | lam {Gamma sigma tau} (q r : AuxTerm Symbol arity (sigma::Gamma) tau) :
      Primary Symbol arity (sigma::Gamma) ⟨tau,q⟩ ⟨tau,r⟩ →
      Primary Symbol arity Gamma ⟨.arrow sigma tau,.lam q⟩ ⟨.arrow sigma tau,.lam r⟩
  | appFunction {Gamma sigma tau} (q r : AuxTerm Symbol arity Gamma (.arrow sigma tau))
      (a : AuxTerm Symbol arity Gamma sigma) :
      Primary Symbol arity Gamma ⟨.arrow sigma tau,q⟩ ⟨.arrow sigma tau,r⟩ →
      Primary Symbol arity Gamma ⟨tau,.app q a⟩ ⟨tau,.app r a⟩
  | appArgument {Gamma sigma tau} (q : AuxTerm Symbol arity Gamma (.arrow sigma tau))
      (a b : AuxTerm Symbol arity Gamma sigma) :
      Primary Symbol arity Gamma ⟨sigma,a⟩ ⟨sigma,b⟩ →
      Primary Symbol arity Gamma ⟨tau,.app q a⟩ ⟨tau,.app q b⟩
  | ordinaryArguments {Gamma} (f : Head Symbol)
      (base target : AuxArguments Symbol arity Gamma (headArguments arity f)) :
      ArgumentPrimary Symbol arity Gamma (headArguments arity f) base target →
      Primary Symbol arity Gamma ⟨headResult f,.ordinary f base⟩ ⟨headResult f,.ordinary f target⟩
  | numberedBase {Gamma} (k : Nat) (f : Head Symbol) (tau : Ty)
      (base target : AuxArguments Symbol arity Gamma (headArguments arity f))
      (types : List Ty) (extras : AuxArguments Symbol arity Gamma types) :
      ArgumentPrimary Symbol arity Gamma (headArguments arity f) base target →
      Primary Symbol arity Gamma ⟨tau,.numbered k f tau base types extras⟩ ⟨tau,.numbered k f tau target types extras⟩
  | numberedExtras {Gamma} (k : Nat) (f : Head Symbol) (tau : Ty)
      (base : AuxArguments Symbol arity Gamma (headArguments arity f))
      (types : List Ty) (extras target : AuxArguments Symbol arity Gamma types) :
      ArgumentPrimary Symbol arity Gamma types extras target →
      Primary Symbol arity Gamma ⟨tau,.numbered k f tau base types extras⟩ ⟨tau,.numbered k f tau base types target⟩
inductive ArgumentPrimary (Symbol : Type) (arity : Symbol → Nat) :
    (Gamma types : List Ty) → AuxArguments Symbol arity Gamma types → AuxArguments Symbol arity Gamma types → Prop where
  | nil {Gamma} : ArgumentPrimary Symbol arity Gamma [] .nil .nil
  | cons {Gamma sigma types} (q r : AuxTerm Symbol arity Gamma sigma)
      (rest target : AuxArguments Symbol arity Gamma types) :
      Primary Symbol arity Gamma ⟨sigma,q⟩ ⟨sigma,r⟩ → ArgumentPrimary Symbol arity Gamma types rest target →
      ArgumentPrimary Symbol arity Gamma (sigma::types) (.cons q rest) (.cons r target)
end

mutual
def size {Symbol : Type} {arity : Symbol → Nat} {Gamma : List Ty} {tau : Ty} : AuxTerm Symbol arity Gamma tau → Nat
  | .var _ | .bottom _ => 1
  | .lam q => 1+size q
  | .app q a => 1+size q+size a
  | .ordinary _ base => 1+argumentsSize base
  | .numbered _ _ _ base _ extras => 1+argumentsSize base+argumentsSize extras
def argumentsSize {Symbol : Type} {arity : Symbol → Nat} {Gamma types : List Ty} : AuxArguments Symbol arity Gamma types → Nat
  | .nil => 0
  | .cons q rest => size q+argumentsSize rest
end

/-- A finite path with its EXACT number of genuine raw reduction steps.
Primary equivalence contributes zero, including under an app argument.
There is still no RAW reduction monotonicity in an app argument. -/
inductive Trace (Symbol : Type) (arity : Symbol → Nat) (above : Symbol → Symbol → Prop) :
    (Gamma : List Ty) → Nat → Packed Symbol arity Gamma → Packed Symbol arity Gamma → Prop where
  | equivalent {Gamma} {q r : Packed Symbol arity Gamma} :
      Primary Symbol arity Gamma q r → Trace Symbol arity above Gamma 0 q r
  | raw {Gamma tau} (q r : AuxTerm Symbol arity Gamma tau) : RawStep Symbol arity above Gamma tau q r →
      Trace Symbol arity above Gamma 1 ⟨tau,q⟩ ⟨tau,r⟩
  | trans {Gamma m n} {q r s : Packed Symbol arity Gamma} :
      Trace Symbol arity above Gamma m q r → Trace Symbol arity above Gamma n r s →
      Trace Symbol arity above Gamma (m+n) q s

end LogicLineages.OrdinalComparison.TerminationOrdering.NumberedPrimaryEquivalence
