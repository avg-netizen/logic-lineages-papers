/-- The acceptance formula is the graph of the same program at output one. -/
private theorem acceptsGraph {α : Type} (p : Program 3) (f u y : OTerm α) :
    accepts p f u y = programGraph p (suc z) ![f, u, y] := rfl

attribute [local irreducible] programGraph

private theorem storedRename {α β : Type} (τ : ProbeTy) (q : OTerm α) (j : α → β) :
    (storedType τ q).relabel j = storedType τ (q.relabel j) := by
  simp only [storedType, programRename, unaryRename, numeralRename]

private theorem storedSubst {α β : Type} (τ : ProbeTy) (q : OTerm α) (s : α → OTerm β) :
    (storedType τ q).subst (fun x => emb (s x)) = storedType τ (q.subst s) := by
  simp only [storedType, programSubst, unarySubst, numeralSubst]

private theorem typedResultRename {α β : Type} (p : Program 3) (τ : ProbeTy)
    (q u : OTerm α) (j : α → β) :
    (typedResultAt p τ q u).relabel j = typedResultAt p τ (q.relabel j) (u.relabel j) := by
  simp only [typedResultAt, existsRename, conjunctionRename, acceptsRename, storedRename,
    Term.relabel_relabel] <;> rfl

private theorem typedResultIntro {body : Positive (Fin 1)} {α : Type} {Γ : List (Formula α)}
    (p : Program 3) (τ : ProbeTy) (q u v : OTerm α)
    (ha : Nonempty (Derivation body Γ (accepts p q u v)))
    (ht : Nonempty (Derivation body Γ (storedType τ v))) :
    Nonempty (Derivation body Γ (typedResultAt p τ q u)) := by
  obtain ⟨a⟩ := ha
  obtain ⟨b⟩ := ht
  apply Nonempty.intro
  unfold typedResultAt
  apply Derivation.existentialIntroduction (emb v)
  simp only [instantiate, bindEmbedding, conjunctionSubst, acceptsSubst, storedSubst, liftBind, varBind]
  exact Derivation.conjunctionIntroduction a b

private theorem addressReportRename {α β : Type} (a c t k : OTerm α) (j : α → β) :
    (addressReport a c t k).relabel j =
      addressReport (a.relabel j) (c.relabel j) (t.relabel j) (k.relabel j) := by
  change (programGraph addressGood (suc z) ![a] ⊓ (programGraph rawContext c ![a] ⊓
      (programGraph rawResult t ![a] ⊓ programGraph rawLeast k ![a]))).relabel j =
    (programGraph addressGood (suc z) ![a.relabel j] ⊓ (programGraph rawContext (c.relabel j) ![a.relabel j] ⊓
      (programGraph rawResult (t.relabel j) ![a.relabel j] ⊓ programGraph rawLeast (k.relabel j) ![a.relabel j])))
  simp only [conjunctionRename, programRename, unaryRename, sucRelabel, zRelabel]

/-- An address report moves along an equation between addresses. -/
private theorem reportTransport {body : Positive (Fin 1)} {α : Type} {Γ : List (Formula α)}
    (s t c ty k : OTerm α)
    (same : Nonempty (Derivation body Γ (eqn s t)))
    (report : Nonempty (Derivation body Γ (addressReport s c ty k))) :
    Nonempty (Derivation body Γ (addressReport t c ty k)) := by
  obtain ⟨r⟩ := report
  have r' : Derivation body Γ (programGraph addressGood (suc z) ![s] ⊓
      (programGraph rawContext c ![s] ⊓ (programGraph rawResult ty ![s] ⊓
        programGraph rawLeast k ![s]))) := r
  obtain ⟨g⟩ := headTransport addressGood (suc z) s t ![] same ⟨Derivation.conjunctionLeft r'⟩
  obtain ⟨x⟩ := headTransport rawContext c s t ![] same
    ⟨Derivation.conjunctionLeft (Derivation.conjunctionRight r')⟩
  obtain ⟨y⟩ := headTransport rawResult ty s t ![] same
    ⟨Derivation.conjunctionLeft (Derivation.conjunctionRight (Derivation.conjunctionRight r'))⟩
  obtain ⟨l⟩ := headTransport rawLeast k s t ![] same
    ⟨Derivation.conjunctionRight (Derivation.conjunctionRight (Derivation.conjunctionRight r'))⟩
  have out : Derivation body Γ (programGraph addressGood (suc z) ![t] ⊓
      (programGraph rawContext c ![t] ⊓ (programGraph rawResult ty ![t] ⊓
        programGraph rawLeast k ![t]))) :=
    Derivation.conjunctionIntroduction g
      (Derivation.conjunctionIntroduction x (Derivation.conjunctionIntroduction y l))
  exact ⟨out⟩

private theorem numeralReport {body : Positive (Fin 1)} {α : Type} {Γ : List (Formula α)}
    (p : Program 1) (n k : Nat) (fit : run p n = k) :
    Nonempty (Derivation body Γ (programGraph p (numeral k) ![numeral n])) := by
  have graph := exact_NumeralGraph 1 p (n ::ᵥ nil) body α Γ
  have inputs : NumberedWindowNumeralGraphTargets.inputs (n ::ᵥ nil) =
      (![numeral n] : Fin 1 → OTerm α) := by
    funext i
    obtain rfl := Fin.eq_zero i
    rfl
  change evaluate p (n ::ᵥ nil) = k at fit
  rw [inputs, fit] at graph
  exact graph

/-- The fresh application from the carrier of the fresh address and the least representative
of the application seed. -/
theorem exact_FreshApplicationFromLeast : FreshApplicationFromLeast := by
  intro S K W A guard c freshCarrier seedLeast σ τ listed α Γ q u held stored fresh
  let body := sourceBody A.presentation c
  let p := A.probes.applicationGuard
  have uHeld := freshCarrier σ τ listed α Γ q u held stored fresh
  have parsed := exact_OpenParsedFresh A.probes.scalarProg A.probes.freshBound body α Γ q u fresh
  unfold parsedFreshAt at parsed
  apply actualFiniteExistentialElimination body α 6 Γ _ (typedResultAt p τ q u) parsed
  rw [typedResultRename]
  let j : α → α ⊕ Fin 6 := Sum.inl
  let q₁ : OTerm (α ⊕ Fin 6) := q.relabel j
  let u₁ : OTerm (α ⊕ Fin 6) := u.relabel j
  let ctx : OTerm (α ⊕ Fin 6) := .var (.inr 0)
  let r : OTerm (α ⊕ Fin 6) := .var (.inr 1)
  let dom : OTerm (α ⊕ Fin 6) := .var (.inr 2)
  let cod : OTerm (α ⊕ Fin 6) := .var (.inr 3)
  let fn : OTerm (α ⊕ Fin 6) := .var (.inr 4)
  let name : OTerm (α ⊕ Fin 6) := .var (.inr 5)
  let payload : OTerm (α ⊕ Fin 6) := consTerm z (consTerm dom (consTerm name z))
  let R : Formula (α ⊕ Fin 6) := addressReports q₁ ctx r fn ⊓ (arrowReports q₁ dom cod ⊓
    (sourceShape q₁ ctx r dom cod fn ⊓
      (programGraph A.probes.freshBound name ![fn] ⊓ equal u₁ (packedFreeTerm ctx dom name))))
  let Δ : List (Formula (α ⊕ Fin 6)) := R :: Γ.map (fun f => f.relabel j)
  have keep : ∀ f ∈ Γ, f.relabel j ∈ Δ := fun f hf =>
    List.mem_cons_of_mem _ (List.mem_map.mpr ⟨f, hf, rfl⟩)
  have main : Nonempty (Derivation body Δ (typedResultAt p τ q₁ u₁)) := by
    have head : Derivation body Δ R := Derivation.hypothesis List.mem_cons_self
    have rest₁ := Derivation.conjunctionRight head
    have arrows : Derivation body Δ (arrowReports q₁ dom cod) := Derivation.conjunctionLeft rest₁
    have rest₂ := Derivation.conjunctionRight rest₁
    have shape : Derivation body Δ (equal q₁ (addressTerm ctx r fn) ⊓ equal r (consTerm dom cod)) :=
      Derivation.conjunctionLeft rest₂
    have uShape : Derivation body Δ (equal u₁ (packedFreeTerm ctx dom name)) :=
      Derivation.conjunctionRight (Derivation.conjunctionRight rest₂)
    have qEq : Derivation body Δ (eqn q₁ (addressTerm ctx r fn)) := by
      have h := Derivation.conjunctionLeft shape
      rw [equalEqn] at h
      exact h
    have rEq : Derivation body Δ (eqn r (rawCons dom cod)) := by
      have h := Derivation.conjunctionRight shape
      rw [equalEqn] at h
      exact h
    have uEq : Derivation body Δ (eqn u₁ (addressTerm ctx dom payload)) := by
      have h := uShape
      rw [equalEqn] at h
      exact h
    have held₁ := renameInto held j Δ keep
    rw [carrierRename] at held₁
    have uHeld₁ := renameInto uHeld j Δ keep
    rw [carrierRename] at uHeld₁
    have stored₁ := renameInto stored j Δ keep
    rw [storedRename] at stored₁
    have fresh₁ := renameInto fresh j Δ keep
    rw [freshRename] at fresh₁
    have fScalar : Nonempty (Derivation body Δ (programGraph A.scalar (suc z) ![q₁])) :=
      (exact_DomainRules A.scalar (jRaw A.scalar) A.path (dCore A.scalar A.path permutation)
        false c body (α ⊕ Fin 6) Δ q₁).mp held₁
    have uScalar : Nonempty (Derivation body Δ (programGraph A.scalar (suc z) ![u₁])) :=
      (exact_DomainRules A.scalar (jRaw A.scalar) A.path (dCore A.scalar A.path permutation)
        false c body (α ⊕ Fin 6) Δ u₁).mp uHeld₁
    have qLiteral : Nonempty (Derivation body Δ (addressReport (addressTerm ctx r fn) ctx r fn)) :=
      exact_OriginalLiteralAddressReport ctx r fn
    obtain ⟨qReport⟩ := reportTransport (addressTerm ctx r fn) q₁ ctx r fn ⟨symm qEq⟩ qLiteral
    have qReport' : Derivation body Δ (programGraph addressGood (suc z) ![q₁] ⊓
        (programGraph rawContext ctx ![q₁] ⊓ (programGraph rawResult r ![q₁] ⊓
          programGraph rawLeast fn ![q₁]))) := qReport
    obtain ⟨resultField⟩ := outputTransport rawResult r (rawCons dom cod) ![q₁] ⟨rEq⟩
      ⟨Derivation.conjunctionLeft (Derivation.conjunctionRight (Derivation.conjunctionRight qReport'))⟩
    have fAddress : Nonempty (Derivation body Δ (addressReport q₁ ctx (rawCons dom cod) fn)) := by
      have out : Derivation body Δ (programGraph addressGood (suc z) ![q₁] ⊓
          (programGraph rawContext ctx ![q₁] ⊓ (programGraph rawResult (rawCons dom cod) ![q₁] ⊓
            programGraph rawLeast fn ![q₁]))) :=
        Derivation.conjunctionIntroduction (Derivation.conjunctionLeft qReport')
          (Derivation.conjunctionIntroduction
            (Derivation.conjunctionLeft (Derivation.conjunctionRight qReport'))
            (Derivation.conjunctionIntroduction resultField
              (Derivation.conjunctionRight (Derivation.conjunctionRight
                (Derivation.conjunctionRight qReport')))))
      exact ⟨out⟩
    have uLiteral : Nonempty (Derivation body Δ
        (addressReport (addressTerm ctx dom payload) ctx dom payload)) :=
      exact_OriginalLiteralAddressReport ctx dom payload
    have uAddress : Nonempty (Derivation body Δ (addressReport u₁ ctx dom payload)) :=
      reportTransport (addressTerm ctx dom payload) u₁ ctx dom payload ⟨symm uEq⟩ uLiteral
    have codN : Nonempty (Derivation body Δ
        (programGraph rawCodomain (numeral (typeCode τ)) ![q₁])) := by
      have cell : chosenCell (typeCode (.arrow σ τ)) = some (typeCode σ, typeCode τ) :=
        cellAt (typeCode σ) (typeCode τ)
      have tailAt : Nonempty (Derivation body Δ (programGraph cellTail (numeral (typeCode τ))
          ![numeral (typeCode (.arrow σ τ))])) :=
        numeralReport cellTail (typeCode (.arrow σ τ)) (typeCode τ) (headTailOfCell cell).2
      unfold rawCodomain applyUnary
      apply compositionValue cellTail (fun _ => rawResult) (numeral (typeCode τ)) ![q₁]
        ![numeral (typeCode (.arrow σ τ))] tailAt
      intro i
      obtain rfl := Fin.eq_zero i
      exact stored₁
    have codEq : Nonempty (Derivation body Δ (eqn cod (numeral (typeCode τ)))) :=
      valueUnique rawCodomain cod (numeral (typeCode τ)) ![q₁]
        ⟨Derivation.conjunctionRight arrows⟩ codN
    obtain ⟨found⟩ := seedLeast σ τ listed (α ⊕ Fin 6) Δ q₁ u₁ ctx dom cod fn payload
      held₁ uHeld₁ stored₁ fresh₁ fAddress uAddress
    let m : α ⊕ Fin 6 → (α ⊕ Fin 6) ⊕ Fin 1 := Sum.inl
    let kk : OTerm ((α ⊕ Fin 6) ⊕ Fin 1) := .var (.inr 0)
    let ψ : Formula ((α ⊕ Fin 6) ⊕ Fin 1) := programGraph A.least (suc kk)
      ![ctx.relabel m, cod.relabel m, (auxiliaryTerm dom cod fn payload).relabel m]
    let Ω : List (Formula ((α ⊕ Fin 6) ⊕ Fin 1)) := ψ :: Δ.map weaken
    have keep₂ : ∀ f ∈ Δ, f.relabel m ∈ Ω := fun f hf =>
      List.mem_cons_of_mem _ (List.mem_map.mpr ⟨f, hf, rfl⟩)
    have found' : Derivation body Δ (existsOne ψ) := found
    have last : Nonempty (Derivation body Ω (weaken (typedResultAt p τ q₁ u₁))) := by
      change Nonempty (Derivation body Ω ((typedResultAt p τ q₁ u₁).relabel m))
      rw [typedResultRename]
      have fAddress₂ := renameInto fAddress m Ω keep₂
      rw [addressReportRename, rawConsRename] at fAddress₂
      have uAddress₂ := renameInto uAddress m Ω keep₂
      rw [addressReportRename] at uAddress₂
      have fScalar₂ := renameInto fScalar m Ω keep₂
      have uScalar₂ := renameInto uScalar m Ω keep₂
      simp only [programRename, unaryRename, sucRelabel, zRelabel] at fScalar₂ uScalar₂
      have codEq₂ := renameInto codEq m Ω keep₂
      simp only [eqnRelabel, numeralRename] at codEq₂
      have latest : Nonempty (Derivation body Ω (programGraph A.least (suc kk)
          ![ctx.relabel m, cod.relabel m,
            (auxiliaryTerm dom cod fn payload).relabel m])) :=
        ⟨Derivation.hypothesis List.mem_cons_self⟩
      rw [auxiliaryRename] at latest
      let y : OTerm ((α ⊕ Fin 6) ⊕ Fin 1) := addressTerm (ctx.relabel m) (cod.relabel m) kk
      have accepted := exact_OpenLiteralApplicationFromReportedLeast A.scalar A.least
        (q₁.relabel m) (u₁.relabel m) y (ctx.relabel m) (dom.relabel m) (cod.relabel m)
        (fn.relabel m) (payload.relabel m) kk fAddress₂ uAddress₂ fScalar₂ uScalar₂ latest
        ⟨refl y⟩
      rw [← guard] at accepted
      have app : Nonempty (Derivation body Ω (accepts p (q₁.relabel m) (u₁.relabel m) y)) := by
        rw [acceptsGraph]
        exact accepted
      have yLiteral : Nonempty (Derivation body Ω
          (addressReport y (ctx.relabel m) (cod.relabel m) kk)) :=
        exact_OriginalLiteralAddressReport (ctx.relabel m) (cod.relabel m) kk
      obtain ⟨yReport⟩ := yLiteral
      have yReport' : Derivation body Ω (programGraph addressGood (suc z) ![y] ⊓
          (programGraph rawContext (ctx.relabel m) ![y] ⊓
            (programGraph rawResult (cod.relabel m) ![y] ⊓ programGraph rawLeast kk ![y]))) :=
        yReport
      have typedY : Nonempty (Derivation body Ω (storedType τ y)) :=
        outputTransport rawResult (cod.relabel m) (numeral (typeCode τ)) ![y] codEq₂
          ⟨Derivation.conjunctionLeft (Derivation.conjunctionRight
            (Derivation.conjunctionRight yReport'))⟩
      exact typedResultIntro p τ (q₁.relabel m) (u₁.relabel m) y app typedY
    obtain ⟨last⟩ := last
    exact ⟨Derivation.existentialElimination found' last⟩
  exact main

