/-- The packet at the front-tested leaves. -/
theorem exact_FrontLambdaJoinedMemoPacketAt (xs : Entries) (s : Settings) (P : List ProbeTy)
    (valid : ValidWindow s P) (seeds : WindowSeedsCovered s)
    (symmetric : HeadPairsSymmetric s.equivalentHeads) (grammar : GrammarTypeInclusion s)
    (included : ∀ ty ∈ finiteCodes P, ty ∈ s.window.1)
    (mk : Program 1 → Program 2)
    (mkFit : ∀ Vs : Program 1, ActualRawSyntax Vs → InstanceFit (mk Vs)) :
    ∃ (cv tv : Program 1) (U : Program 2) (leaves : Nat → Program 3) (other : Program 3)
      (baseX base₀ : Program 2) (T V₀ baseM₀ : Program 1) (placed : Inputs),
      let Tg := selectedBiAuxType s T tv
      let V := variableFrontSyntax tv V₀
      let baseM := namedMeasureBase baseM₀
      let base := variableFrontWindow Tg base₀
      let Va := unitAuxSyntax V tv
      let leaf := withBetaLeaf Va U leaves
      let C := measuredStrictCover V tv baseM
      let W := joinedAuxiliaryWindow s base Tg V tv baseM
      let raw := strictDualRaw C s leaf (lambdaFallback other) base base Tg Va Tg
      let Base := joinedBiAuxBase s baseX base Tg V tv baseM
      let E := recursiveTypedMemo Base
      let L := guardedLeast (headerLeast (fullAuxiliaryDecorator (packedLeastOn C E s)))
      let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
      ActualRawSyntax Va ∧ U = mk Va ∧
      InstanceFit U ∧ Packet xs s P i cv tv (guardedRaw raw) L (applicationCore L) placed ∧
      placed.applicationGuard = applicationGuard i L ∧
      CanReverse Base ∧ WindowEndpoints W E ∧ Preserves E (packedLeastOn C E s) ∧
      MemoSelectedReports C s Base ∧ OpenRankTypeGuards P Tg tv ∧
      (∀ (c : Nat) (α : Type) (Γ : List (Formula α)) (f u y : OTerm α),
        let data := S i cv tv (rawWithTarget i cv tv (guardedRaw raw) L) L
        let B := sourceBody data c
        D B Γ (programGraph (applicationGuard i L) (suc z) ![f,u,y]) →
        D B Γ (carrier data false c y) ∧ D B Γ (atom neutralSource y)) := by
  obtain ⟨oldI,cv,tv,oldLeaf,oldC,oldOther,oldDirected,oldRawBase,oldRawT,oldV,v,orig,_⟩ :=
    exact_ConcretePairedCoveredTypedAuxTuple xs s P valid seeds symmetric
  obtain ⟨base₀,T,baseFit₀,TFit⟩ := exact_WindowPrimitiveLeaves s
  obtain ⟨baseX,_,baseXFit,_,_⟩ := exact_SelectedPackedScalarEdge s
  obtain ⟨V₀,baseM₀,_,vFit₀,mFit₀,_,_⟩ := exact_SelectedFactoredCover
  obtain ⟨oldOtherLeaf,oldOtherFit⟩ := exact_ConcreteFallback
  let other := lambdaFallback oldOtherLeaf
  have otherFit := exact_LiteralLambdaFallback oldOtherLeaf oldOtherFit
  have calls := orig.physical.2.2.1
  let Tg := selectedBiAuxType s T tv
  have typeFit₀ := exact_PhysicalRankTypeGuard s T tv grammar TFit calls.2.1
  let V := variableFrontSyntax tv V₀
  have vFit := exact_VariableFrontSyntaxCalibrated tv V₀ calls.2.1 vFit₀
  let baseM := namedMeasureBase baseM₀
  have mFit := exact_CoverNamedLeafMeasureBase baseM₀ mFit₀
  let base := variableFrontWindow Tg base₀
  have baseFit := exact_VariableFrontWindowCalibrated s Tg base₀ typeFit₀ baseFit₀
  let Va := unitAuxSyntax V tv
  let U := mk Va
  let leaves := leafAtAuxiliary oldLeaf
  let leaf := withBetaLeaf Va U leaves
  let M := chosenMeasure baseM
  let C := measuredStrictCover V tv baseM
  let X := selectedBiAuxExchange s baseX V tv baseM
  let W := joinedAuxiliaryWindow s base Tg V tv baseM
  let raw := strictDualRaw C s leaf other base base Tg Va Tg
  let oldX := guardedExchange oldC s (pairedExchange oldDirected)
  let oldL := packedLeastProgram oldC oldX (coveredMemoWindow oldC s oldRawBase oldRawT oldV) s
  let Base := joinedBiAuxBase s baseX base Tg V tv baseM
  let E := recursiveTypedMemo Base
  let L₀ := fullAuxiliaryDecorator (packedLeastOn C E s)
  let L := guardedLeast (headerLeast L₀)
  let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
  let oldRaw := ActiveRaw oldC s oldLeaf oldOther oldRawBase oldRawT oldV
  let r := addressPositive cv tv oldRaw oldL
  let d := dCore oldI r permutation
  have typeFit := exact_PhysicalRankTypeGuard s T tv grammar TFit calls.2.1
  have rawSyntaxFit := exact_LiteralUnitAuxSyntax V tv vFit calls.2.1
  have vaFit : ActualRawSyntax Va := rawSyntaxFit
  have uFit : InstanceFit U := mkFit Va vaFit
  have selectedMeasureFit := exact_PhysicalAuxMeasure baseM chosenCombine mFit exact_ChosenAuxMeasureCombine
  have coverFit := exact_FactoredCoverCalibration Va M selectedGrammarOption rawSyntaxFit selectedMeasureFit
    exact_SelectedGrammarOption
  have xFit := exact_LiteralMeasuredBiAuxExchange s baseX Va baseM chosenCombine selectedGrammarOption
    symmetric baseXFit rawSyntaxFit selectedMeasureFit coverFit
  let Z := selectedBiAuxWindow s base Tg V tv baseM
  have strictFit := exact_StrictSealedWindowCalibration C s base Tg coverFit seeds baseFit typeFit
  let A := coveredMemoWindow C s base Tg Va
  have Afit := exact_CoveredMemoWindow C s base Tg Va coverFit seeds baseFit typeFit rawSyntaxFit
  have windowFit := exact_LiteralJoinedAuxiliaryWindow s base Tg V tv baseM strictFit Afit
  have baseFitWhole := exact_WholeEdgeWithObservers s (edge4 X W) childGuardObservers
    (exact_WholeOriginalEdge s X W xFit windowFit) (exact_ChildGuardObserversStable s)
  have edgeFit := exact_WholeRecursiveTypedMemo s Base baseFitWhole symmetric
  have leastFit := exact_LiteralPackedLeastOn C E s coverFit (exact_PackedEdgeFromWhole s E edgeFit)
  have extra := exact_FullAuxiliaryDecoratorCalibration s seeds symmetric (packedLeastOn C E s) leastFit
  have head := exact_LiteralHeaderLeast s L₀ extra
  have hL := exact_LiteralAtomicGuardedLeast s (headerLeast L₀) head
  have leafFit := exact_LiteralBetaLeafFit xs s.window.2 Va U rawSyntaxFit uFit leaves orig.fit
  have rootFit := exact_LiteralRootNumeric (fixed xs s.window.2) (leafAtAuxiliary leaf)
    (exact_AuxiliaryLeafFit xs s.window.2 leaf leafFit)
  let P₀ := root (leafAtAuxiliary leaf)
  let F := fallback other
  have FFit := exact_DescendingFallback other otherFit
  have sideA := exact_LiteralAuxiliaryAtomicTypedRawCalibration xs s P₀ F A Va rootFit FFit Afit rawSyntaxFit
  have sideW := exact_LiteralAuxiliaryAtomicTypedRawCalibration xs s P₀ F Z Va rootFit FFit strictFit rawSyntaxFit
  have rawFit := exact_LiteralDualRawCalibration xs s P₀ F A Z Va sideA sideW
  have repl := exact_ReinstallCalibratedRawTuple xs s P valid oldI (jRaw oldI) cv tv d
    (applicationCore oldL) oldRaw raw oldL v orig.physical rawFit
  have lifted := exact_ReinstallCalibratedLeast xs s P valid oldI (jRaw oldI) cv tv d (applicationCore oldL)
    raw oldL L v repl hL
  let v₀ := frontendInputs oldI L v
  have app := (exact_ReinstallGuardedApplicationTuple xs s P valid oldI (jRaw oldI)
    cv tv d (applicationCore oldL) raw L v lifted).2
  have scalarFit := exact_LiteralAddressScalarCalibration s cv tv W L calls.1 calls.2.1 windowFit hL
  have cal := exact_LiteralFiniteScalarCalibration s (addressScalar cv tv W L) P valid.1 scalarFit
  have rebuilt := (exact_ReinstallLiteralScalar xs s P valid i oldI (jRaw oldI) cv tv d
    (applicationCore L) raw L v₀ cal app).2
  have baseEnds : WindowEndpoints W Base := exact_OpenSuiteWindowEndpoints W (edge4 X W) childGuardObservers
    (exact_OpenOriginalWindowEndpoints X W)
  have baseCovered : CoveredEndpoints C s Base := by
    apply exact_OpenCoveredWindowEndpoints C s W Base baseEnds
    intro B α Γ ctx ty seed held
    have old := ((exact_OpenJoinedAuxiliaryWindow s base Tg V tv baseM ctx ty seed).mp held).1
    exact ((exact_OpenSealedWindow C s (strictAuxWindow base Tg) ctx ty seed).1 old).2
  let directed := measuredExchange M (biAuxRawMemo baseX Va)
  have baseSame := exact_OpenEdgeWithObserversCover C s (edge4 X W) childGuardObservers
    (exact_OpenPairedEdgeCover C directed W s)
  have baseReverse := exact_OpenEdgeWithObserversReverses (edge4 X W) childGuardObservers
    (exact_OpenPairedEdgeReverses C directed W s)
  have baseGuards := exact_OpenInstalledObserver (edge4 X W) childGuardObservers
  obtain ⟨ends,coherent,selected⟩ :=
    exact_OpenTypedMemoLeastLaws exact_OriginalPhysicalCountLength exact_OriginalPhysicalCountStrict
      C W s Base baseGuards baseReverse baseSame baseCovered baseEnds
  have guards := exact_OpenRankTypeGuards s P T tv tv grammar TFit calls.2.1 calls.2.1 included
  refine ⟨cv,tv,U,leaves,oldOtherLeaf,baseX,base₀,T,V₀,baseM₀,frontendInputs i L v₀,vaFit,rfl,uFit,
    exact_ReinstallLiteralAtomicRawPacket xs s P valid i (jRaw oldI) cv tv d (applicationCore L)
      raw L (frontendInputs i L v₀) rebuilt,rfl,baseReverse,ends,coherent,selected,guards,?_⟩
  intro c α Γ f u y data B accepted
  have forms : OpenAuxFormation C s W Tg := by
    intro B α Γ ctx dom cod fn arg hd hc hf ha cover
    exact (exact_OpenJoinedAuxiliaryParent s base Tg V tv baseM ctx dom cod fn arg
      (exact_OpenBiAuxTypeEvidence s T tv dom cod hd hc) hf ha).1
  exact exact_OpenEnrichedApplicationClosure s P valid.2.1 cv tv Tg C W E forms
    fullAuxiliaryDecorator exact_FullAuxiliaryDecoratorOpen calls.2.1 typeFit included ends coherent raw c f u y accepted

