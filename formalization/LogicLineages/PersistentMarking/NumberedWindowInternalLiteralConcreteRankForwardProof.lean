/-- Choose the actual physically ranked positive and application
checkers together. Their full numerical answers are the original
ones and the original open forward rule holds on that same tuple.
This theorem says nothing about inversion on any other physical tuple. -/
theorem exact_ConcreteCalibratedRankForward (xs : Entries) (s : Settings) (P : List ProbeTy)
    (valid : ValidWindow s P) (symmetry : HeadPairsSymmetric s.equivalentHeads)
    (seeds : WindowSeedsCovered s) (grammar : GrammarTypeInclusion s)
    (types : ∀ n ∈ finiteCodes P, n ∈ s.window.1) :
    ∃ (i : Program 1) (positive app : Program 3),
      ActualScalarCalibration s i ∧
      (∀ x path y, evaluate positive (x ::ᵥ path ::ᵥ y ::ᵥ nil) =
        (NumberedWindowConcreteCheckers.positive xs s x path y).toNat) ∧
      (∀ f u y, evaluate app (f ::ᵥ u ::ᵥ y ::ᵥ nil) =
        (NumberedWindowAddressApplication.graph s f u y).toNat) ∧
      (∀ c : Nat, ForwardRule (literalData i positive) app c) := by
  obtain ⟨_,cv,tv,leaf,_,_,_,_,_,_,_,old,_⟩ :=
    exact_ConcretePairedCoveredTypedAuxTuple xs s P valid seeds symmetry
  obtain ⟨base,_,baseFit,_,_⟩ := exact_SelectedPackedScalarEdge s
  obtain ⟨intrinsic,T,intrinsicFit,tFit⟩ := exact_WindowPrimitiveLeaves s
  obtain ⟨V,baseM,_,vFit,mFit,_,_⟩ := exact_SelectedFactoredCover
  have calls := old.physical.2.2.1
  have cvFit := calls.1
  have tvFit := calls.2.1
  obtain ⟨leafFallback,leafFit⟩ := exact_ConcreteFallback
  let rootP := root (leafAtAuxiliary leaf)
  let other := fallback leafFallback
  have rootFit := exact_LiteralRootNumeric (fixed xs s.window.2) (leafAtAuxiliary leaf) old.fit
  have otherFit := exact_DescendingFallback leafFallback leafFit
  let Tg := conjunction (refitGuard s T) tv
  let Va := auxSyntax V tv
  let M := selectedMeasure (measureUpdate baseM chosenCombine)
  let C := factoredCover Va M selectedGrammarOption
  let W := selectedWindow s intrinsic Tg V tv baseM
  let X := rankedExchange C s (auxRank spineRankLeaf) (measuredExchange M (selected (step base Va)))
  let raw := typedRaw5 rootP other W Va
  let L := packedLeastProgram C X W s
  let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
  obtain ⟨_,_,_,leastFit,scalarFit,positiveFit⟩ :=
    exact_LiteralRankPhysicalCalibration xs s P base intrinsic V tv T baseM cv tv rootP other
      symmetry seeds grammar valid.1 baseFit intrinsicFit vFit tvFit tFit mFit cvFit tvFit rootFit otherFit
  refine ⟨i,positiveEndpointGuard i (addressPositive cv tv raw L),applicationGuard i L,
    scalarFit,positiveFit,exact_AllInputGuardedApplication s i L scalarFit leastFit,?_⟩
  intro c
  exact exact_OpenRankGuardedForwardRule s P valid.2.1 base intrinsic V tv T baseM cv tv spineRankLeaf
    rootP other c (exact_OpenRankTypeGuards s P T tv tv grammar tFit tvFit tvFit types)

#print axioms exact_ConcreteCalibratedRankForward
