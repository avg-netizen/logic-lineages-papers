attribute [local irreducible] programGraph
variable {α : Type} {Γ : List (Formula α)}

private theorem resultScalar (s : Settings) (P : List ProbeTy) (closed : ChildClosed P)
    (base intrinsic : Program 2) (V TV T baseM cv tv rank : Program 1) (root other : Program 3)
    (c : Nat) (f u x ctx res dom cod fn arg chosen : OTerm α) :
    let Tg := conjunction (refitGuard s T) TV
    let Va := auxSyntax V TV
    let M := selectedMeasure (measureUpdate baseM chosenCombine)
    let C := factoredCover Va M selectedGrammarOption
    let W := selectedWindow s intrinsic Tg V TV baseM
    let D₀ := measuredExchange (auxRank rank) (measuredExchange M (selected (step base Va)))
    let X := guardedExchange C s (pairedExchange D₀)
    let raw := typedRaw5 root other W Va
    let L := packedLeastProgram C X W s
    let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
    let data := literalData i (positiveEndpointGuard i (addressPositive cv tv raw L))
    let B := sourceBody data c
    OpenRankTypeGuards P Tg tv →
    D B Γ (unary i (suc z) f) → D B Γ (unary i (suc z) u) →
    D B Γ (parsedApplicationInputs f u ctx res dom cod fn arg) →
    D B Γ (leastGraph C X W s ctx cod (auxiliaryTerm dom cod fn arg) chosen) →
    D B Γ (eqn x (addressTerm ctx cod chosen)) → D B Γ (unary i (suc z) x) := by
  intro Tg Va M C W D₀ X raw L i data B typeRule hf hu parsed report emitted
  let ft := rawCons dom cod
  let i₀ := addressScalar cv tv W L
  obtain ⟨fd,ad,_⟩ := exact_OpenParsedOperandAddresses f u ctx res dom cod fn arg parsed
  obtain ⟨fAddr⟩ := fd
  obtain ⟨aAddr⟩ := ad
  have fType : D B Γ (unary rawResult ft f) :=
    ⟨Derivation.conjunctionLeft (Derivation.conjunctionRight (Derivation.conjunctionRight fAddr))⟩
  have aType : D B Γ (unary rawResult dom u) :=
    ⟨Derivation.conjunctionLeft (Derivation.conjunctionRight (Derivation.conjunctionRight aAddr))⟩
  obtain ⟨fGuard,fList⟩ := exact_OpenLiteralFiniteScalar i₀ (finiteCodes P) f ft fType hf
  obtain ⟨aGuard,aList⟩ := exact_OpenLiteralFiniteScalar i₀ (finiteCodes P) u dom aType hu
  have cList := exact_OpenLiteralFiniteCodomain P closed dom cod fList
  obtain ⟨aT,_⟩ := typeRule B α Γ dom aList
  obtain ⟨cT,cTV⟩ := typeRule B α Γ cod cList
  obtain ⟨aT⟩ := aT
  obtain ⟨cT⟩ := cT
  have types : D B Γ (unary Tg (suc z) dom ⊓ unary Tg (suc z) cod) :=
    ⟨Derivation.conjunctionIntroduction aT cT⟩
  obtain ⟨gc,_,_,atF,atU⟩ := exact_OpenLiteralApplicationInputCoordinates cv tv W L
    f u ctx res dom cod fn arg fGuard aGuard parsed
  obtain ⟨formation⟩ := exact_OpenOriginalSelectedGuardFormation s intrinsic T V TV baseM ctx dom cod arg types atU
  obtain ⟨formed⟩ := atFunction W ctx dom cod arg fn formation
  obtain ⟨atF⟩ := atF
  have actual := Derivation.implicationElimination formed atF
  have paid := exact_OpenRankCoveredCoherence C (syntaxWindow (selectedBase intrinsic Tg) Va) D₀ s
  have scalar := exact_OpenPlainFiniteScalarAtLeast cv tv C W X s paid (finiteCodes P)
    ctx cod (auxiliaryTerm dom cod fn arg) chosen gc cTV cList ⟨actual⟩ report
  obtain ⟨eq⟩ := emitted
  exact headTransport i (suc z) (literalAddress ctx cod chosen) x ![] ⟨symm eq⟩ scalar

/-- Both neutral-application closure conclusions on the exact same
rank tuple that checks forward and first-hop transport. -/
theorem exact_OpenRankApplicationClosure (s : Settings) (P : List ProbeTy) (closed : ChildClosed P)
    (base intrinsic : Program 2) (V TV T baseM cv tv rank : Program 1) (root other : Program 3)
    (c : Nat) (f u x : OTerm α) :
    let Tg := conjunction (refitGuard s T) TV
    let Va := auxSyntax V TV
    let M := selectedMeasure (measureUpdate baseM chosenCombine)
    let C := factoredCover Va M selectedGrammarOption
    let W := selectedWindow s intrinsic Tg V TV baseM
    let D₀ := measuredExchange (auxRank rank) (measuredExchange M (selected (step base Va)))
    let X := guardedExchange C s (pairedExchange D₀)
    let raw := typedRaw5 root other W Va
    let L := packedLeastProgram C X W s
    let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
    let data := literalData i (positiveEndpointGuard i (addressPositive cv tv raw L))
    let B := sourceBody data c
    OpenRankTypeGuards P Tg tv →
    D B Γ (atom (rankNeutral (auxRank rank)) f) →
    D B Γ (programGraph (applicationGuard i L) (suc z) ![f,u,x]) →
    D B Γ (carrier data false c x) ∧ D B Γ (atom (rankNeutral (auxRank rank)) x) := by
  intro Tg Va M C W D₀ X raw L i data B typeRule neutral accepted
  refine ⟨?_,exact_OpenRankNeutralApplication C W s rank (measuredExchange M (selected (step base Va)))
    i f u x neutral accepted⟩
  apply exact_OpenLiteralApplicationRows i L f u x _ accepted
  intro β j Δ ctx res dom cod fn arg chosen _ left right parsed report emitted
  rw [carrierRename]
  have scalar := resultScalar s P closed base intrinsic V TV T baseM cv tv rank root other c
    (f.relabel j) (u.relabel j) (x.relabel j) ctx res dom cod fn arg chosen typeRule left right parsed report emitted
  let r := positiveEndpointGuard i (addressPositive cv tv raw L)
  exact (exact_DomainRules i (jRaw i) r (dCore i r permutation) false c B β Δ (x.relabel j)).2 scalar

#print axioms exact_OpenRankApplicationClosure
end LogicLineages.PersistentMarking.NumberedWindowInternalLiteralRankApplicationClosureProof
