module
public import LogicLineages.PersistentMarking.NumberedWindowInternalSparseTupleTargets
public import LogicLineages.PersistentMarking.NumberedWindowInternalSparseTypedRawSelectionTargets

@[expose] public section
namespace LogicLineages.PersistentMarking.NumberedWindowInternalSparseTypedRawInstallationTargets
open LogicLineages.ComputabilityKnowledge.GorbowPRProgram
open NumberedWindowCopyAlgorithm (Entries)
open NumberedWindowScalarAlgorithm (Settings)
open NumberedWindowInternalFreshProbeDispatchWindowTargets (ProbeTy ValidWindow)
open NumberedWindowInternalFreshProbeParsedTyped (Inputs)
open NumberedWindowInternalSparsePathAdvanceTargets (ActualRawCalibration)
open NumberedWindowInternalSparseTuple (InstalledTupleAt)
open NumberedWindowInternalSparseRawTickTargets (ActualRoot ActualFallback)
open NumberedWindowInternalSparseTypedRaw (typedRaw5)
open NumberedWindowInternalSparseTypedRawTargets (ActualRawSyntax ActualPackedWindow)

/-- Rebuild the entire existing tuple on the physical address program
generated by the new raw callback. Only a proof of its exact original
all-input calibration is requested; no graph or body equality is
assumed. The same window and every other program/Inputs leaf stay. -/
def ExactReinstallCalibratedRawTuple : Prop :=
  ∀ (entries : Entries) (s : Settings) (W : List ProbeTy), ValidWindow s W →
    ∀ (i j cv tv : Program 1) (d p₀ : Program 3) (oldRaw newRaw : Program 5)
      (least : Program 3) (v : Inputs),
      InstalledTupleAt entries s W i j cv tv d p₀ oldRaw least v →
      ActualRawCalibration entries s newRaw →
      InstalledTupleAt entries s W i j cv tv d p₀ newRaw least v

/-- One existing original tuple supplies all common physical leaves,
including the selected least and original guarded application Inputs.
The new raw callback is literally typedRaw5 of the separately selected
actual callees, not an unrelated equally evaluated Program5. The old
tuple remains available unchanged alongside the full new-body tuple. -/
def ExactConcreteSparseTypedRawInstalledTuple : Prop :=
  ∀ (entries : Entries) (s : Settings) (W : List ProbeTy), ValidWindow s W →
    ∃ (i j cv tv : Program 1) (d p₀ : Program 3) (oldRaw : Program 5)
      (least : Program 3) (v : Inputs) (root other windowProg : Program 3)
      (syntaxProg : Program 1),
      InstalledTupleAt entries s W i j cv tv d p₀ oldRaw least v ∧
      ActualRoot (NumberedWindowConcreteCheckers.root entries s) root ∧
      ActualFallback other ∧ ActualRawSyntax syntaxProg ∧ ActualPackedWindow s windowProg ∧
      InstalledTupleAt entries s W i j cv tv d p₀
        (typedRaw5 root other windowProg syntaxProg) least v

end LogicLineages.PersistentMarking.NumberedWindowInternalSparseTypedRawInstallationTargets
