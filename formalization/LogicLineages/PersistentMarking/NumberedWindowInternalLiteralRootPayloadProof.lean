/-- Bind precisely the consecutive physical raw field selectors;
the ordered list is generated by internal graph totality. -/
private theorem selectorCases (B : Positive (Fin 1)) (arity : Nat) :
    ∀ (α : Type) (Γ : List (Formula α)) (w : OTerm α) (cursor : Program 1) (goal : Formula α),
      (∀ (β : Type) (j : α → β) (Δ : List (Formula β)) (values : List (OTerm β)),
        (∀ f ∈ Γ, f.relabel j ∈ Δ) → values.length = arity →
        Reports B Δ (w.relabel j) cursor values → D B Δ (goal.relabel j)) → D B Γ goal := by
  induction arity with
  | zero =>
    intro α Γ w cursor goal next
    have one := next α id Γ [] (fun f h => by simpa only [renameIdentity] using h) rfl trivial
    simpa only [renameIdentity] using one
  | succ arity ih =>
    intro α Γ w cursor goal next
    apply programCases (applyUnary cellHead cursor) ![w] goal
    intro β j Δ field keep first
    rw [inputsRename] at first
    apply ih β Δ (w.relabel j) (applyUnary cellTail cursor) (goal.relabel j)
    intro γ k Ω rest retain size others
    have keeps (f : Formula α) (h : f ∈ Γ) : f.relabel (k ∘ j) ∈ Ω := by
      simpa only [formulaRelabelComposition] using retain _ (keep f h)
    have head := moveReport k Ω retain (applyUnary cellHead cursor) field (w.relabel j) first
    have actual : Reports B Ω (w.relabel (k ∘ j)) cursor (field.relabel k :: rest) :=
      ⟨by simpa only [Term.relabel_relabel] using head,by simpa only [Term.relabel_relabel] using others⟩
    have result := next γ (k ∘ j) Ω (field.relabel k :: rest) keeps (by simp [size]) actual
    simpa only [formulaRelabelComposition] using result

/-- A true physical route guard binds an exact literal node with the
chosen tag and that many field terms, not merely an external tag number. -/
theorem exact_OpenLiteralRootPayload (tag arity : Nat)
    {B : Positive (Fin 1)} {α : Type} {Γ : List (Formula α)} (q w r : OTerm α) (goal : Formula α)
    (held : D B Γ (bit (guard tag arity) ![q,w,r]))
    (next : ∀ (β : Type) (j : α → β) (Δ : List (Formula β)) (values : List (OTerm β)),
      (∀ f ∈ Γ, f.relabel j ∈ Δ) → values.length = arity →
      D B Δ (eqn (w.relabel j) (rawCons (numeral tag) (packedBody values))) →
      Reports B Δ (w.relabel j) cellTail values → D B Δ (goal.relabel j)) :
    D B Γ goal := by
  let tagProgram := literal 1 tag
  have read : D B Γ (unary (nodeGood tagProgram arity) (suc z) w) := by
    apply compositionRecover (nodeGood tagProgram arity) ![.projection 1] (suc z)
      ![q,w,r] ![w] held
    intro k
    obtain rfl := Fin.eq_zero k
    exact projectionValue 1 ![q,w,r]
  apply selectorCases B arity α Γ w cellTail goal
  intro β j Δ values keep size reports
  have guardAtValues := moveReport j Δ keep (nodeGood tagProgram arity) (suc z) w read
  have atSize : D B Δ (unary (nodeGood tagProgram values.length) (suc z) (w.relabel j)) := by
    rw [size]
    simpa only [sucRelabel,zRelabel] using guardAtValues
  have equation := readNode tagProgram (w.relabel j) (numeral tag) values (literalGraph tag ![w.relabel j])
    atSize reports
  exact next β j Δ values keep size equation reports

/-- Live typed root-step classification with its original root payload,
actual packed fields, and selected per-rule acceptance. This is the
root wrapper; traversal through arbitrary contextual wrappers is not
being asserted here. -/
theorem exact_OpenTypedRootPayloadCases (leaf : Nat → Program 3) (other window : Program 3)
    (syntaxCheck : Program 1) {B : Positive (Fin 1)} {α : Type} {Γ : List (Formula α)}
    (ctx ty q w r : OTerm α) (goal : Formula α)
    (held : D B Γ (programGraph (typedRaw5 (root leaf) other window syntaxCheck) (suc z)
      ![ctx,ty,q,rootWitnessTerm w,r]))
    (next : ∀ tag arity, (tag,arity) ∈ shapes →
      ∀ (β : Type) (j : α → β) (Δ : List (Formula β)) (values : List (OTerm β)),
        (∀ f ∈ Γ, f.relabel j ∈ Δ) → values.length = arity →
        D B Δ (eqn (w.relabel j) (rawCons (numeral tag) (packedBody values))) →
        D B Δ (bit (leaf tag) ![q.relabel j,w.relabel j,r.relabel j]) →
        D B Δ (goal.relabel j)) : D B Γ goal := by
  apply exact_OpenLiteralTypedRootCases leaf other window syntaxCheck ctx ty q w r goal held
  intro tag arity known Δ keep accepted selected
  apply exact_OpenLiteralRootPayload tag arity q w r goal accepted
  intro β j Ω values keeps size equation _
  have carried := renameInto selected j Ω keeps
  simp only [programRename,tripleInputsRename,sucRelabel,zRelabel] at carried
  exact next tag arity known β j Ω values (fun f h => keeps f (keep f h)) size equation carried

#print axioms exact_OpenLiteralRootPayload
#print axioms exact_OpenTypedRootPayloadCases
