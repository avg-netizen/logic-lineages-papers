variable {α : Type} {Γ : List (Formula α)}

/-- A certified positive function path has canonical endpoints on
the original installed coordinates. With the original parsed argument,
its checked result therefore maps to a new application and exact edge. -/
theorem exact_OpenJoinedForwardFromRows (s : Settings) (P : List ProbeTy) (closed : ChildClosed P)
    (X base : Program 2) (T V baseM cv tv : Program 1) (leaf : Nat → Program 3) (other : Program 3)
    (c : Nat) (f g u x ctx res dom cod fn arg before sc st fromTerm dest path : OTerm α) :
    let Tg := selectedBiAuxType s T tv
    let C := measuredStrictCover V tv baseM
    let W := joinedAuxiliaryWindow s base Tg V tv baseM
    let Base := joinedBiAuxBase s X base Tg V tv baseM
    let E := recursiveTypedMemo Base
    let L₀ := packedLeastOn C E s
    let L := memoFilteredLeast C Base s
    let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
    let raw := selectedJoinedRaw s base Tg V tv baseM leaf other
    let R := rawWithTarget i cv tv raw L
    let data := S i cv tv R L
    let B := sourceBody data c
    CanReverse Base → WindowEndpoints W E → Preserves E L₀ → MemoSelectedReports C s Base →
    OpenRankTypeGuards P Tg tv →
    D B Γ (unary i (suc z) f) → D B Γ (unary i (suc z) u) →
    D B Γ (parsedApplicationInputs f u ctx res dom cod fn arg) →
    D B Γ (programGraph L (suc before) ![ctx,cod,auxiliaryTerm dom cod fn arg]) →
    D B Γ (eqn x (addressTerm ctx cod before)) →
    D B Γ (addressReport f sc st fromTerm) → D B Γ (addressReport g sc st dest) →
    D B Γ (programGraph (positive R L) (suc z) ![sc,st,fromTerm,path,dest]) →
    D B Γ (forwardImage data (applicationGuard i L) c g u x) := by
  intro Tg C W Base E L₀ L i raw R data B reverse ends stable selected typeRule hf hu parsed original emitted start finish step
  let funTy := rawCons dom cod
  let scalar := addressScalar cv tv W L
  obtain ⟨fnReport,argReport,feq⟩ := exact_OpenParsedOperandAddresses f u ctx res dom cod fn arg parsed
  obtain ⟨ec,et,eqf⟩ := alignSource f ctx funTy fn sc st fromTerm feq start
  have gReport := exact_OpenRetapeAddress g sc st dest ctx funTy dest finish ec et ⟨refl dest⟩
  have pathHeld := exact_OpenRetapePositiveFold (positive R L) sc st fromTerm path dest ctx funTy fn ec et eqf step
  obtain ⟨fr⟩ := fnReport
  obtain ⟨gr⟩ := gReport
  obtain ⟨ar⟩ := argReport
  have fTy : D B Γ (unary rawResult funTy f) :=
    ⟨Derivation.conjunctionLeft (Derivation.conjunctionRight (Derivation.conjunctionRight fr))⟩
  have gTy : D B Γ (unary rawResult funTy g) :=
    ⟨Derivation.conjunctionLeft (Derivation.conjunctionRight (Derivation.conjunctionRight gr))⟩
  have aTy : D B Γ (unary rawResult dom u) :=
    ⟨Derivation.conjunctionLeft (Derivation.conjunctionRight (Derivation.conjunctionRight ar))⟩
  obtain ⟨scalarF,typesF⟩ := exact_OpenLiteralFiniteScalar scalar (finiteCodes P) f funTy fTy hf
  obtain ⟨scalarU,typesU⟩ := exact_OpenLiteralFiniteScalar scalar (finiteCodes P) u dom aTy hu
  have typesCod := exact_OpenLiteralFiniteCodomain P closed dom cod typesF
  obtain ⟨domT,_⟩ := typeRule B α Γ dom typesU
  obtain ⟨codT,codTV⟩ := typeRule B α Γ cod typesCod
  obtain ⟨_,funTV⟩ := typeRule B α Γ funTy typesF
  obtain ⟨gc,_,_,_,winU⟩ := exact_OpenLiteralApplicationInputCoordinates cv tv W L
    f u ctx res dom cod fn arg scalarF scalarU parsed
  let K : MatchContext := ⟨Tg,cv,tv,finiteCodes P,W⟩
  obtain ⟨dd⟩ := domT
  obtain ⟨kd⟩ := codT
  obtain ⟨gcD⟩ := gc
  obtain ⟨gtD⟩ := codTV
  obtain ⟨listed⟩ := typesCod
  obtain ⟨argW⟩ := winU
  have form : D B Γ (typedFormation K ctx dom cod arg) :=
    ⟨Derivation.conjunctionIntroduction (Derivation.conjunctionIntroduction dd kd)
      (Derivation.conjunctionIntroduction argW
        (Derivation.conjunctionIntroduction gcD (Derivation.conjunctionIntroduction gtD listed)))⟩
  have law := exact_OpenJoinedAdvanceCoordinates s X base Tg V tv baseM i cv tv leaf other ends stable
  obtain ⟨pathWindow⟩ := exact_PositiveWindows R L (canonicalCoordinates W L) law B α Γ ctx funTy fn path dest
  obtain ⟨pathProof⟩ := pathHeld
  have coord := Derivation.conjunctionRight (Derivation.implicationElimination pathWindow pathProof)
  obtain ⟨read⟩ := openTest W L B α Γ ctx funTy dest
  have winG : D B Γ (windowAt W ctx funTy dest) :=
    ⟨Derivation.conjunctionLeft (Derivation.implicationElimination (Derivation.conjunctionLeft read) coord)⟩
  obtain ⟨gGate⟩ := reported cv tv W L B α Γ g ctx funTy dest
  let gates := Derivation.implicationElimination gGate gr
  obtain ⟨funTV⟩ := funTV
  have rawG : D B Γ (unary scalar (suc z) g) :=
    ⟨Derivation.implicationElimination (Derivation.conjunctionRight gates)
      (Derivation.conjunctionIntroduction gcD (Derivation.conjunctionIntroduction funTV coord))⟩
  have gs := exact_MakeLiteralFiniteScalar scalar (finiteCodes P) g funTy gTy rawG typesF
  have atX := exact_OpenLiteralReportedAddress x ctx cod before emitted
  obtain ⟨_,push⟩ := exact_OpenJoinedForwardPath s X base T V baseM cv tv leaf other (finiteCodes P)
    ctx dom cod arg fn dest path before reverse ends stable selected form winG ⟨pathProof⟩ original
  exact exact_OpenJoinedForwardOutput i cv tv R L c g u x ctx dom cod dest arg before
    ⟨gcD⟩ ⟨gtD⟩ ⟨gr⟩ gs ⟨ar⟩ hu atX push

#print axioms exact_OpenJoinedForwardFromRows
end LogicLineages.PersistentMarking.NumberedWindowInternalLiteralJoinedForwardRowsProof
