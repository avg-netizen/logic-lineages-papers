private theorem ownValue (C : Program 3) (s : Settings) (hC : ActualSelectedCoverOutput C)
    (ctx ty seed : Nat) : evaluate (ownSeed C s) (ctx ::ᵥ ty ::ᵥ seed ::ᵥ nil) =
      ((vertices s seed).any (fun head => head == seed)).toNat := by
  let xs := ctx ::ᵥ ty ::ᵥ seed ::ᵥ nil
  have v : evaluate (poolAtSeed C s) xs = numbersNumber (vertices s seed) := by
    rw [poolAtSeed,unaryValue]
    exact scratchVerticesValue C hC s seed
  change evaluate scratchMember (List.Vector.ofFn (fun i : Fin 2 =>
    evaluate ((![poolAtSeed C s,.projection 2] : Fin 2 → Program 3) i) xs)) = _
  rw [vectorTwo]
  change evaluate scratchMember (evaluate (poolAtSeed C s) xs ::ᵥ seed ::ᵥ nil) = _
  rw [v,NumberedWindowInternalSparseScratchMembershipNumericChecks.exact_AllInputScratchMembership,numbersRoundTrip]
  rfl

private theorem coveredValue : ExactCoveredWindowCalibration := by
  intro C s baseW hC covered original ctx ty seed
  let xs := ctx ::ᵥ ty ::ᵥ seed ::ᵥ nil
  change evaluate (coveredWindow C s baseW) xs = _
  rw [coveredWindow,actualConjunctionEvaluation]
  have w : evaluate baseW xs = (packedWindow s ctx ty seed).toNat := original ctx ty seed
  rw [w]
  cases hit : packedWindow s ctx ty seed with
  | false => rfl
  | true =>
    obtain ⟨g,parse,accepted⟩ : ∃ g, unpack ctx = some g ∧ NumberedWindowScalarAlgorithm.admitted s g ty seed = true := by
      cases q : unpack ctx with
      | none => simp [packedWindow,q] at hit
      | some g => exact ⟨g,rfl,by simpa [packedWindow,q] using hit⟩
    have pc : evaluate contextPresent xs = 1 := by
      rw [contextPresent,evalBranch]
      change (if evaluate NumberedWindowInternalSparsePackedLeast.contextOption (ctx ::ᵥ ty ::ᵥ seed ::ᵥ nil) = 0 then _ else _) = _
      rw [contextValue,parse]
      rfl
    have q : evaluate (ownSeed C s) xs = 1 := by
      rw [ownValue C s hC ctx ty seed]
      simp [covered g ty seed accepted]
    rw [actualConjunctionEvaluation,pc,q]
    rfl

private theorem exact_SyntaxWindowCalibration : NumberedWindowInternalMeasuredUnrestrictedWindowDefinitions.ExactSyntaxWindowCalibration := by
  intro s baseW V original valid ctx ty seed
  rw [syntaxWindow,actualConjunctionEvaluation,original]
  cases h : packedWindow s ctx ty seed with
  | false => rfl
  | true =>
    have syntaxTrue : (syntaxBits seed).1 = true := by
      cases u : unpack ctx with
      | none => simp [packedWindow,u] at h
      | some xs =>
        have ok : admitted s xs ty seed = true := by simpa [packedWindow,u] using h
        exact (Bool.and_eq_true_iff.mp (Bool.and_eq_true_iff.mp ok).2).1
    rw [unaryValue]
    change (if 1 = 1 ∧ evaluate V (seed ::ᵥ nil) = 1 then 1 else 0) = _
    exact if_pos ⟨rfl,(valid seed).trans (by rw [syntaxTrue]; rfl)⟩

theorem exact_PhysicalRankTypeGuard (s : Settings) (T TV : Program 1)
    (inside : GrammarTypeInclusion s) (typeFit : TypeGuardCalibrated s T) (tvFit : ActualTypeGuard TV) :
    TypeGuardCalibrated s (conjunction (refitGuard s T) TV) := by
  intro q
  have h := exact_SettingsRefitGuardCalibration s T inside typeFit q
  unfold run at h ⊢
  rw [actualConjunctionEvaluation,h,tvFit q]
  cases good : typeBit q <;> by_cases seen : q ∈ s.window.1 <;> simp [typeGuard,good,seen]

theorem exact_OpenRankTypeGuards (s : Settings) (P : List ProbeTy) (T TV tv : Program 1)
    (inside : GrammarTypeInclusion s) (typeFit : TypeGuardCalibrated s T)
    (TVfit : ActualTypeGuard TV) (tvFit : ActualTypeGuard tv)
    (types : ∀ t ∈ finiteCodes P, t ∈ s.window.1) :
    OpenRankTypeGuards P (conjunction (refitGuard s T) TV) tv := by
  intro B α Γ t held
  obtain ⟨pubReport,internal⟩ := exact_OpenLiteralFiniteTypeTests s P tv (conjunction (refitGuard s T) TV)
    tvFit (exact_PhysicalRankTypeGuard s T TV inside typeFit TVfit) types t held
  exact ⟨internal,pubReport⟩

/-- Fit the actual selected rank-measured callbacks used by the open
forward rule, including the checked address endpoint guards. No syntax
or positive checker is changed on malformed or well-formed inputs. -/
theorem exact_LiteralRankPhysicalCalibration (xs : Entries) (s : Settings) (P : List ProbeTy)
    (base intrinsic : Program 2) (V TV T baseM cv tv : Program 1) (root other : Program 3)
    (symmetry : HeadPairsSymmetric s.equivalentHeads) (seeds : WindowSeedsCovered s)
    (grammar : GrammarTypeInclusion s) (support : TypeSupport s P)
    (baseFit : ActualTermExchange s base) (intrinsicFit : IntrinsicWindowCalibrated s intrinsic)
    (vFit : TermSyntaxCalibrated V) (TVfit : ActualTypeGuard TV) (tFit : TypeGuardCalibrated s T)
    (measureFit : TermMeasureCalibrated baseM)
    (gc : ActualContextGuard cv) (gt : ActualTypeGuard tv)
    (rootFit : ActualRoot (NumberedWindowConcreteCheckers.root xs s) root) (otherFit : ActualFallback other) :
    let Tg := conjunction (refitGuard s T) TV
    let Va := auxSyntax V TV
    let M := selectedMeasure (measureUpdate baseM chosenCombine)
    let C := factoredCover Va M selectedGrammarOption
    let W := selectedWindow s intrinsic Tg V TV baseM
    let X := rankedExchange C s (auxRank spineRankLeaf) (measuredExchange M (selected (step base Va)))
    let raw := typedRaw5 root other W Va
    let L := packedLeastProgram C X W s
    let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
    ActualPackedWindow s W ∧ ActualTermExchange s X ∧ ActualRawCalibration xs s raw ∧
    ActualLeastCalibration s L ∧ ActualScalarCalibration s i ∧
    (∀ x cert y, evaluate (positiveEndpointGuard i (addressPositive cv tv raw L))
      (x ::ᵥ cert ::ᵥ y ::ᵥ nil) = (NumberedWindowConcreteCheckers.positive xs s x cert y).toNat) := by
  intro Tg Va M C W X raw L i
  have Vfit : TermSyntaxCalibrated Va := exact_CoverAuxSyntaxCalibration V TV vFit TVfit
  have mfit : TermMeasureCalibrated M :=
    exact_PhysicalAuxMeasure baseM chosenCombine measureFit exact_ChosenAuxMeasureCombine
  have cfit : ActualSelectedCoverOutput C :=
    exact_FactoredCoverCalibration Va M selectedGrammarOption Vfit mfit exact_SelectedGrammarOption
  have baseWin : ActualPackedWindow s (selectedBase intrinsic Tg) :=
    exact_PhysicalAuxWindow s intrinsic Tg intrinsicFit (exact_PhysicalRankTypeGuard s T TV grammar tFit TVfit)
  have wFit : ActualPackedWindow s W := coveredValue C s
    (syntaxWindow (selectedBase intrinsic Tg) Va) cfit seeds (exact_SyntaxWindowCalibration s _ Va baseWin Vfit)
  have directed := exact_PhysicalAuxMemoExchange s base Va baseFit Vfit
  have measured := exact_LiteralMeasuredExchangeCalibration s M (selected (step base Va)) mfit directed
  have xFit : ActualTermExchange s X := exact_LiteralSpineRankedExchange C s _ cfit symmetry measured
  have rawFit : ActualRawCalibration xs s raw := exact_TypedRaw5Calibration xs s root other W Va
    rootFit otherFit Vfit wFit
  have lFit : ActualLeastCalibration s L := exact_PackedLeastComposition s C X W cfit xFit wFit
  have iFit : ActualScalarCalibration s i := exact_LiteralFiniteScalarCalibration s _ P support
    (exact_LiteralAddressScalarCalibration s cv tv W L gc gt wFit lFit)
  let P₀ := addressPositive cv tv raw L
  have pos := exact_AddressPositiveComposition xs s cv tv raw L gc gt
    (exact_FoldComposition xs s raw L (exact_AdvanceComposition xs s raw L rawFit lFit)).2
  refine ⟨wFit,xFit,rawFit,lFit,iFit,?_⟩
  intro x cert y
  have fit : PositiveEndpointFit i P₀ := by
    intro a w b holds
    have yes := pos a w b
    rw [show evaluate P₀ (a ::ᵥ w ::ᵥ b ::ᵥ nil) = 1 from holds] at yes
    have accept : NumberedWindowConcreteCheckers.positive xs s a w b = true := by
      cases h : NumberedWindowConcreteCheckers.positive xs s a w b
      · rw [h] at yes
        change (1 : Nat) = 0 at yes
        contradiction
      · rfl
    obtain ⟨source,target⟩ := exact_ConcretePositiveScalarEndpoints xs s a w b accept
    simpa [iFit a,iFit b,source,target]
  have bool : ∀ tape, evaluate P₀ tape = 0 ∨ evaluate P₀ tape = 1 := by
    intro tape
    let a := tape.get 0
    let w := tape.get 1
    let b := tape.get 2
    have eq : tape = a ::ᵥ w ::ᵥ b ::ᵥ nil := by
      apply List.Vector.ext
      exact fun j => Fin.cases rfl (Fin.cases rfl (Fin.cases rfl (fun k => Fin.elim0 k))) j
    rw [eq,pos]
    cases NumberedWindowConcreteCheckers.positive xs s a w b <;> simp
  exact (exact_PositiveEndpointGuardCalibration i P₀ fit bool x cert y).trans (pos x cert y)

