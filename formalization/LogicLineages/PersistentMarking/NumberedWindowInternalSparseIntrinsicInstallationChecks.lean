private theorem functionEdge (V baseM : Program 1) (P : Program 2) (G : Program 3)
    (s : Settings) (base : Program 2) (baseW : Program 3) :
    let M := selectedMeasure (measureUpdate baseM P)
    let C := factoredCover V M G
    FunctionApplicationAt C s (measuredFactoredExchange s base V baseM P G) (window C s baseW V) := by
  intro M C body α Γ ctx dom cod f g arg value a b E input
  let W := window C s baseW V
  let X := measuredFactoredExchange s base V baseM P G
  let Δ := input :: Γ
  have h : Derivation body Δ input := Derivation.hypothesis List.mem_cons_self
  obtain ⟨child⟩ := exact_OpenPackedScalarEdge X W body α Δ ctx (rawCons dom cod) f g
  have x := Derivation.conjunctionLeft
    (Derivation.implicationElimination (Derivation.conjunctionLeft child) (Derivation.conjunctionLeft h))
  have ws := Derivation.conjunctionRight h
  obtain ⟨leftSyntax⟩ := exact_WindowSyntaxReport C s baseW V body α Δ ctx cod a
  obtain ⟨rightSyntax⟩ := exact_WindowSyntaxReport C s baseW V body α Δ ctx cod b
  have ls := Derivation.implicationElimination leftSyntax (Derivation.conjunctionLeft ws)
  have rs := Derivation.implicationElimination rightSyntax (Derivation.conjunctionRight ws)
  obtain ⟨lifted⟩ := exact_OpenMeasuredFactoredAuxLift s base V baseM P G body α Δ dom cod f g arg
  have exchanged := Derivation.implicationElimination lifted
    (Derivation.conjunctionIntroduction x (Derivation.conjunctionIntroduction ls rs))
  obtain ⟨parent⟩ := exact_OpenPackedScalarEdge X W body α Δ ctx cod a b
  have edge := Derivation.implicationElimination (Derivation.conjunctionRight parent)
    (Derivation.conjunctionIntroduction exchanged ws)
  obtain ⟨law⟩ := NumberedWindowInternalSparseCoveredInstallationChecks.exact_CoveredEdgeValues C s
    (measuredExchange M (selected (step base V))) (syntaxWindow baseW V) body α Δ ctx cod a b value
  have transfer := Derivation.conjunctionLeft (Derivation.conjunctionRight (Derivation.implicationElimination law edge))
  exact ⟨Derivation.implicationIntroduction (Derivation.conjunctionIntroduction edge transfer)⟩

theorem exact_InstallIntrinsicPrograms : ExactInstallIntrinsicPrograms := by
  intro V baseM P G validV validBase combine grammar
  let M := selectedMeasure (measureUpdate baseM P)
  let C := factoredCover V M G
  have measure := exact_PhysicalAuxMeasure baseM P validBase combine
  have cover := exact_FactoredCoverCalibration V M G validV measure grammar
  dsimp only [IntrinsicAt]
  intro entries s W valid symmetric covered
  obtain ⟨_,_,tuples⟩ := exact_DirectedInstallation
  obtain ⟨i,j,cv,tv,previousV,base,d,oldCore,oldLeast,root,other,priorW,v,hRoot,hOther,
    _,_,hBase,_,typedTuple,_⟩ := tuples entries s W valid
  obtain ⟨intrinsicBase,T,hB,hT⟩ := NumberedWindowInternalAuxWindowStepPrograms.exact_WindowPrimitiveLeaves s
  let baseW := intrinsicQuery (selectedIntrinsic (windowUpdate intrinsicBase T))
  have hBaseW := NumberedWindowInternalAuxWindowStepChecks.exact_PhysicalAuxWindow s intrinsicBase T hB hT
  let improvedW := syntaxWindow baseW V
  let memo := measuredExchange M (selected (step base V))
  let Wp := window C s baseW V
  let X := measuredFactoredExchange s base V baseM P G
  let raw := typedRaw5 root other Wp V
  let least := packedLeastProgram C X Wp s
  let newI := addressScalar cv tv Wp least
  have startWindow := exact_SyntaxWindowCalibration s baseW V hBaseW validV
  have hw := NumberedWindowInternalSparseCoveredWindowChecks.exact_CoveredWindowCalibration C s improvedW cover covered startWindow
  have hx := exact_MeasuredExchangeCalibration s M (selected (step base V)) measure
    (exact_PhysicalAuxMemoExchange s base V hBase validV)
  have hp := exact_PairedCalibration s memo symmetric hx
  have he := exact_GuardedExchangeCalibration C s (pairedExchange memo) cover hp
  have cal := exact_PackedLeastComposition s C X Wp cover he hw
  have rc := NumberedWindowInternalSparseTypedRawChecks.exact_TypedRaw5Calibration entries s root other Wp V hRoot hOther validV hw
  have newRaw := NumberedWindowInternalSparseTypedRawInstallationChecks.exact_ReinstallCalibratedRawTuple entries s W valid
    i j cv tv d oldCore (typedRaw5 root other priorW previousV) raw oldLeast v typedTuple rc
  have full := exact_ReinstallCalibratedLeast entries s W valid i j cv tv d oldCore raw oldLeast least v newRaw cal
  have scalar := exact_AddressScalarCalibration s cv tv Wp least full.2.2.1.1 full.2.2.1.2.1 hw cal
  obtain ⟨sameA,installed⟩ := exact_ReinstallScalar entries s W valid newI i j cv tv d oldCore raw least v scalar full
  have edgeRule := functionEdge V baseM P G s base baseW
  have representative := NumberedWindowInternalSparseFormationRepresentativeChecks.exact_FormationRepresentative C s X Wp edgeRule
  have calls := NumberedWindowInternalSparseMatchedCallsChecks.exact_MatchedCalls C root other baseW X V s representative
  have advance := NumberedWindowInternalSparseMatchedAdvanceChecks.exact_MatchedAdvance C X Wp s raw calls
  have path := NumberedWindowInternalSparseMatchedPathChecks.exact_MatchedPath C X Wp s raw advance
  exact ⟨i,j,cv,tv,base,intrinsicBase,T,d,oldCore,oldLeast,root,other,v,hRoot,hOther,hBase,hB,hT,hBaseW,
    NumberedWindowInternalAuxWindowOpenChecks.exact_OpenAuxWindow intrinsicBase T,he,hw,cal,scalar,
    newRaw,full,sameA,installed,exact_PhysicalEdgeCarriers C s memo improvedW root other V cv tv j d,
    exact_UnconditionalCoverOccurrence C X Wp s,exact_MinimumEdgeBound exact_RetainedPredecessor C X Wp s,
    exact_PhysicalPositiveWindowsFromRetained exact_RetainedPredecessor C X Wp root other V s,
    NumberedWindowInternalSparseCoverInstallationEdgeProof.edgeCover C s (pairedExchange memo) Wp,
    NumberedWindowInternalSparseAdjacentMinimumChecks.exact_EdgeMinimumOrder C s (pairedExchange memo) Wp,
    NumberedWindowInternalSparseAdjacentMinimumChecks.exact_MutualEdgeMinimumEquality C s (pairedExchange memo) Wp,
    NumberedWindowInternalSparseSymmetricExchangeChecks.exact_PairedEdgeMinimumEquality C s memo Wp,
    NumberedWindowInternalSparseCoveredInstallationChecks.exact_CoveredEdgeValues C s memo improvedW,
    functionEdge V baseM P G s base baseW,
    NumberedWindowInternalSparseApplicationHopChecks.exact_ExistentialApplicationHop C root other baseW V X s,path⟩

theorem exact_IntrinsicInstallation : ExactIntrinsicInstallation := by
  obtain ⟨V,baseM,G,validV,validBase,grammar,_⟩ := exact_SelectedFactoredCover
  obtain ⟨P,combine⟩ := exact_CombineProgram
  have measure := exact_PhysicalAuxMeasure baseM P validBase combine
  exact ⟨V,baseM,P,G,validV,validBase,combine,grammar,
    exact_FactoredCoverCalibration V _ G validV measure grammar,
    exact_InstallIntrinsicPrograms V baseM P G validV validBase combine grammar⟩

