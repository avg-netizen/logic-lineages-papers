/-- The original open forward rule on the physical rank-measured
tuple with both actual scalar endpoint guards. Neither neutrality nor
a supplied mapped path or later application is assumed. -/
theorem exact_OpenRankGuardedForwardRule (s : Settings) (P : List ProbeTy) (closed : ChildClosed P)
    (base intrinsic : Program 2) (V TV T baseM cv tv rank : Program 1) (root other : Program 3) (c : Nat) :
    let Tg := conjunction (refitGuard s T) TV
    let Va := auxSyntax V TV
    let M := selectedMeasure (measureUpdate baseM chosenCombine)
    let C := factoredCover Va M selectedGrammarOption
    let W := selectedWindow s intrinsic Tg V TV baseM
    let D₀ := measuredExchange (auxRank rank) (measuredExchange M (selected (step base Va)))
    let X := guardedExchange C s (pairedExchange D₀)
    let raw := typedRaw5 root other W Va
    let L := packedLeastProgram C X W s
    let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
    let data := literalData i (positiveEndpointGuard i (addressPositive cv tv raw L))
    OpenRankTypeGuards P Tg tv → ForwardRule data (applicationGuard i L) c := by
  intro Tg Va M C W D₀ X raw L i data types α Γ f g u x app edge
  apply exact_OpenGuardedPositiveCertificateRows i cv tv raw L c f g
    (forwardImage data (applicationGuard i L) c g u x) edge
  intro β j Δ sc st before after path keep atF atG _ gOK _ _ fold
  rw [imageRename]
  have a := renameInto app j Δ keep
  rw [acceptsRename] at a
  have held : Nonempty (Derivation (sourceBody data c) Δ
      (programGraph (applicationGuard i L) (suc z) ![f.relabel j,u.relabel j,x.relabel j])) := by
    unfold accepts programGraph at *
    exact a
  apply exact_OpenLiteralApplicationRows i L (f.relabel j) (u.relabel j) (x.relabel j)
    (forwardImage data (applicationGuard i L) c (g.relabel j) (u.relabel j) (x.relabel j)) held
  intro γ k Θ ctx res dom cod fn arg result stay fOK uOK parsed original output
  rw [imageRename]
  have start := renameInto atF k Θ stay
  have finish := renameInto atG k Θ stay
  rw [addressReportRename] at start finish
  have g' := renameInto gOK k Θ stay
  rw [unaryRename,sucRelabel,zRelabel] at g'
  have path' := renameInto fold k Θ stay
  rw [graph5Rename,sucRelabel,zRelabel] at path'
  exact exact_OpenRankForwardFromRows s P closed base intrinsic V TV T baseM cv tv rank root other c
    ((f.relabel j).relabel k) ((g.relabel j).relabel k) ((u.relabel j).relabel k) ((x.relabel j).relabel k)
    ctx res dom cod fn arg result (sc.relabel k) (st.relabel k) (before.relabel k) (after.relabel k)
    (path.relabel k) types fOK g' uOK parsed original output start finish path'

#print axioms exact_OpenRankGuardedForwardRule
