/-- Install the literal dual raw checker and the strict sealed window
with preguarded child minima, and retain actual application closure. Nothing is identified using numeric fit. -/
theorem exact_ConcretePairedEnrichedApplicationPacket (xs : Entries) (s : Settings) (P : List ProbeTy)
    (valid : ValidWindow s P) (seeds : WindowSeedsCovered s)
    (symmetric : HeadPairsSymmetric s.equivalentHeads)
    (included : ∀ ty ∈ finiteCodes P, ty ∈ s.window.1) :
    ∃ (cv tv : Program 1) (leaf : Nat → Program 3) (C other : Program 3)
      (directed rawBase base : Program 2) (rawT V T : Program 1) (placed : Inputs),
      let X := guardedExchange C s (pairedExchange directed)
      let W := strictSealedWindow C s base T
      let raw := strictDualRaw C s leaf other rawBase base rawT V T
      let E := withObservers (edge4 X W) childGuardObservers
      let L := guardedLeast (headerLeast (fullAuxiliaryDecorator (packedLeastOn C E s)))
      let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
      Packet xs s P i cv tv (guardedRaw raw) L (applicationCore L) placed ∧
      WindowEndpoints W E ∧ Preserves E (packedLeastOn C E s) ∧
      (∀ (c : Nat) (α : Type) (Γ : List (Formula α)) (f u y : OTerm α),
        let data := S i cv tv (rawWithTarget i cv tv (guardedRaw raw) L) L
        let B := sourceBody data c
        D B Γ (programGraph (applicationGuard i L) (suc z) ![f,u,y]) →
        D B Γ (carrier data false c y) ∧ D B Γ (atom neutralSource y)) := by
  obtain ⟨oldI,cv,tv,leaf,C,oldOther,directed,rawBase,rawT,V,v,orig,_⟩ :=
    exact_ConcretePairedCoveredTypedAuxTuple xs s P valid seeds symmetric
  obtain ⟨base,T,baseFit,TFit⟩ := exact_WindowPrimitiveLeaves s
  obtain ⟨other,otherFit⟩ := exact_ConcreteFallback
  let X := guardedExchange C s (pairedExchange directed)
  let W := strictSealedWindow C s base T
  let raw := strictDualRaw C s leaf other rawBase base rawT V T
  let oldL := packedLeastProgram C X (coveredMemoWindow C s rawBase rawT V) s
  let E := withObservers (edge4 X W) childGuardObservers
  let L₀ := fullAuxiliaryDecorator (packedLeastOn C E s)
  let L := guardedLeast (headerLeast L₀)
  let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
  let oldRaw := ActiveRaw C s leaf oldOther rawBase rawT V
  let r := addressPositive cv tv oldRaw oldL
  let d := dCore oldI r permutation
  have windowFit := exact_StrictSealedWindowCalibration C s base T orig.coverFit seeds baseFit TFit
  have edgeFit := exact_WholeEdgeWithObservers s (edge4 X W) childGuardObservers
    (exact_WholeOriginalEdge s X W orig.exchangeFit windowFit) (exact_ChildGuardObserversStable s)
  have leastFit := exact_LiteralPackedLeastOn C E s orig.coverFit (exact_PackedEdgeFromWhole s E edgeFit)
  have extra := exact_FullAuxiliaryDecoratorCalibration s seeds symmetric (packedLeastOn C E s) leastFit
  have head := exact_LiteralHeaderLeast s L₀ extra
  have hL := exact_LiteralAtomicGuardedLeast s (headerLeast L₀) head
  have rootFit := exact_LiteralRootNumeric (fixed xs s.window.2) (leafAtAuxiliary leaf) orig.fit
  let P₀ := root (leafAtAuxiliary leaf)
  let F := fallback other
  let A := coveredMemoWindow C s rawBase rawT V
  have FFit := exact_DescendingFallback other otherFit
  have sideA := exact_LiteralAuxiliaryAtomicTypedRawCalibration xs s P₀ F A V rootFit FFit orig.windowFit orig.syntaxFit
  have sideW := exact_LiteralAuxiliaryAtomicTypedRawCalibration xs s P₀ F W V rootFit FFit windowFit orig.syntaxFit
  have rawFit := exact_LiteralDualRawCalibration xs s P₀ F A W V sideA sideW
  have repl := exact_ReinstallCalibratedRawTuple xs s P valid oldI (jRaw oldI) cv tv d
    (applicationCore oldL) oldRaw raw oldL v orig.physical rawFit
  have lifted := exact_ReinstallCalibratedLeast xs s P valid oldI (jRaw oldI) cv tv d (applicationCore oldL)
    raw oldL L v repl hL
  let v₀ := frontendInputs oldI L v
  have app := (exact_ReinstallGuardedApplicationTuple xs s P valid oldI (jRaw oldI)
    cv tv d (applicationCore oldL) raw L v lifted).2
  have calls := orig.physical.2.2.1
  have scalarFit := exact_LiteralAddressScalarCalibration s cv tv W L calls.1 calls.2.1 windowFit hL
  have cal := exact_LiteralFiniteScalarCalibration s (addressScalar cv tv W L) P valid.1 scalarFit
  have rebuilt := (exact_ReinstallLiteralScalar xs s P valid i oldI (jRaw oldI) cv tv d
    (applicationCore L) raw L v₀ cal app).2
  have ends : WindowEndpoints W E := exact_OpenSuiteWindowEndpoints W (edge4 X W) childGuardObservers
    (exact_OpenOriginalWindowEndpoints X W)
  have covered : CoveredEndpoints C s E := by
    apply exact_OpenCoveredWindowEndpoints C s W E ends
    intro B α Γ ctx ty seed held
    exact ((exact_OpenSealedWindow C s (strictAuxWindow base T) ctx ty seed).1 held).2
  have same := exact_OpenEdgeWithObserversCover C s (edge4 X W) childGuardObservers
    (exact_OpenPairedEdgeCover C directed W s)
  have reverse := exact_OpenEdgeWithObserversReverses (edge4 X W) childGuardObservers
    (exact_OpenPairedEdgeReverses C directed W s)
  have coherent := exact_OpenLeastOnPreserves exact_OriginalPhysicalCountLength
    exact_OriginalPhysicalCountStrict C E s reverse same covered
  refine ⟨cv,tv,leaf,C,other,directed,rawBase,base,rawT,V,T,frontendInputs i L v₀,
    exact_ReinstallLiteralAtomicRawPacket xs s P valid i (jRaw oldI) cv tv d (applicationCore L)
      raw L (frontendInputs i L v₀) rebuilt,ends,coherent,?_⟩
  intro c α Γ f u y data B accepted
  have forms : OpenAuxFormation C s W T := by
    intro B α Γ ctx dom cod fn arg hd hc hf ha cover
    exact exact_OpenStrictSealedAuxParent C s base T ctx dom cod fn arg hd hc hf ha cover
  exact exact_OpenEnrichedApplicationClosure s P valid.2.1 cv tv T C W E forms
    fullAuxiliaryDecorator exact_FullAuxiliaryDecoratorOpen calls.2.1 TFit included ends coherent raw c f u y accepted

