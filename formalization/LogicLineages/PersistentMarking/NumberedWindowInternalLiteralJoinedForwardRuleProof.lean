/-- Forward closure on the same actual original data used for neutral
inversion. Neither installed program nor source body is changed. -/
theorem exact_OpenJoinedForwardRule (s : Settings) (P : List ProbeTy) (closed : ChildClosed P)
    (X base : Program 2) (T V baseM cv tv : Program 1) (leaf : Nat → Program 3) (other : Program 3) (c : Nat) :
    let Tg := selectedBiAuxType s T tv
    let C := measuredStrictCover V tv baseM
    let W := joinedAuxiliaryWindow s base Tg V tv baseM
    let Base := joinedBiAuxBase s X base Tg V tv baseM
    let E := recursiveTypedMemo Base
    let L₀ := packedLeastOn C E s
    let L := memoFilteredLeast C Base s
    let i := finiteScalar (addressScalar cv tv W L) (finiteCodes P)
    let raw := selectedJoinedRaw s base Tg V tv baseM leaf other
    let R := rawWithTarget i cv tv raw L
    let data := S i cv tv R L
    CanReverse Base → WindowEndpoints W E → Preserves E L₀ → MemoSelectedReports C s Base →
    OpenRankTypeGuards P Tg tv → ForwardRule data (applicationGuard i L) c := by
  intro Tg C W Base E L₀ L i raw R data reverse ends stable selected types α Γ f g u x app edge
  apply exact_OpenLiteralPositiveCertificateRows i cv tv R L c f g
    (forwardImage data (applicationGuard i L) c g u x) edge
  intro β j Δ sc st before after path keep atF atG _ _ fold
  rw [imageRename]
  have a := renameInto app j Δ keep
  rw [acceptsRename] at a
  have held : Nonempty (Derivation (sourceBody data c) Δ
      (programGraph (applicationGuard i L) (suc z) ![f.relabel j,u.relabel j,x.relabel j])) := by
    rw [← exact_OriginalApplicationAcceptedGraph]
    exact a
  apply exact_OpenLiteralApplicationRows i L (f.relabel j) (u.relabel j) (x.relabel j)
    (forwardImage data (applicationGuard i L) c (g.relabel j) (u.relabel j) (x.relabel j)) held
  intro γ k Θ ctx res dom cod fn arg result stay fOK uOK parsed original output
  rw [imageRename]
  have start := renameInto atF k Θ stay
  have finish := renameInto atG k Θ stay
  rw [addressReportRename] at start finish
  have path' := renameInto fold k Θ stay
  rw [graph5Rename,sucRelabel,zRelabel] at path'
  exact exact_OpenJoinedForwardFromRows s P closed X base T V baseM cv tv leaf other c
    ((f.relabel j).relabel k) ((g.relabel j).relabel k) ((u.relabel j).relabel k) ((x.relabel j).relabel k)
    ctx res dom cod fn arg result (sc.relabel k) (st.relabel k) (before.relabel k) (after.relabel k)
    (path.relabel k) reverse ends stable selected types fOK uOK parsed original output start finish path'

