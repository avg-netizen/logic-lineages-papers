import LogicLineages.PersistentMarking.NameBridge
import LogicLineages.PersistentMarking.Signature
namespace LogicLineages.PersistentMarking.BridgeTargets
open Spine NameBridge

/-- The relation is generated by actual fresh binder renaming and structural
congruence, not defined to mean equality of encodings. -/
def EncodeRespectsAlpha : Prop :=
  ∀ env a b, Alpha a b → encode env a = encode env b

def DecodeEncodeAlpha : Prop := ∀ a, Alpha a (decode [] (encode [] a))

def EncodeDecodeScoped : Prop := ∀ q, Scoped [] q → encode [] (decode [] q) = q

def AlphaExact : Prop := ∀ a b, Alpha a b ↔ encode [] a = encode [] b

def OpeningBridge : Prop :=
  ∀ σ x z body, nameOccurs (σ,z) body = false → z ≠ x →
    encode [] (renameFree (σ,x) (σ,z) body) = openBody σ z (encode [(σ,x)] body)

def TypedClosedScoped : Prop := ∀ q σ, Typed EmptyContext q σ → Scoped [] q

def OpeningTyped : Prop := ∀ σ τ body x,
  Typed (EmptyContext.push σ) body τ → Typed EmptyContext (openBody σ x body) τ

def FreshOpeningExists : Prop := ∀ σ s t,
  ∃ x, freeOccurs (σ,x) s = false ∧ freeOccurs (σ,x) t = false


def EncodeTypingExact : Prop := ∀ env q σ,
  NamedTyped q σ ↔ Typed (BoundContext.«prefix» (env.map Prod.fst) EmptyContext) (encode env q) σ

def DecodeTyping : Prop := ∀ q σ,
  Typed EmptyContext q σ → NamedTyped (decode [] q) σ

def EncodeValidityExact : Prop := ∀ S env q,
  NamedValid S q ↔ Valid S (encode env q)

end LogicLineages.PersistentMarking.BridgeTargets
